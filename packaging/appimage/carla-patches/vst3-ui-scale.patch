+   #ifndef CARLA_OS_MAC
+    // Carlita: tell the view the UI scale (IPlugViewContentScaleSupport),
+    // before it is attached. Only when it is not 1.0: at 1.0 plugins keep
+    // their own scaling, as in hosts that say nothing (Windows plugins under
+    // yabridge follow Wine's DPI, which 1.0 would override).
+    void setViewContentScale(const float scale)
+    {
+        if (carla_isZero(scale) || carla_isEqual(scale, 1.0f))
+            return;
+
+        v3_plugin_view_content_scale** contentScale = nullptr;
+        if (v3_cpp_obj_query_interface(fV3.view, v3_plugin_view_content_scale_iid, &contentScale) != V3_OK
+            || contentScale == nullptr)
+            return;
+
+        v3_cpp_obj(contentScale)->set_content_scale_factor(contentScale, scale);
+        v3_cpp_obj_unref(contentScale);
+    }
+   #endif
