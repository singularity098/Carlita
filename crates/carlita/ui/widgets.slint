// Large, touch-friendly building blocks.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icons.slint";
import { Tip, Tips } from "tooltip.slint";

export { Tip, Tips }

// String helpers implemented in Rust (Slint has no substring operations).
export global TextUtil {
    // On-screen keyboard editing at a text field's cursor: the text after
    // typing `insert` (or, with `backspace`, after deleting the selection or
    // the character before the cursor), and the cursor's byte offset after
    // it. `anchor` and `cursor` are the field's selection, as byte offsets.
    pure callback edit(text: string, anchor: int, cursor: int, insert: string, backspace: bool) -> string;
    pure callback edit-cursor(text: string, anchor: int, cursor: int, insert: string, backspace: bool) -> int;
    // A MIDI port's name without the repeated device name and the ALSA
    // client:port numbers ("Scarlett 18i20 USB:Scarlett 18i20 USB MIDI 1
    // 24:0" becomes "Scarlett 18i20 USB MIDI 1").
    pure callback port-label(string) -> string;
}

export component BigButton inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    // A drawn icon (paths from `Icons`), used instead of `icon`.
    in property <string> icon-line;
    in property <string> icon-solid;
    in property <bool> primary: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    // Hover help (see tooltip.slint).
    in property <string> tip;
    callback clicked;

    min-height: Theme.touch;
    min-width: Theme.touch;
    horizontal-stretch: 0;
    border-radius: Theme.radius;
    background: root.primary && root.enabled ? (touch.pressed ? Theme.paint-pressed : Theme.paint)
        : touch.pressed ? Theme.pressed
        : root.danger ? Theme.danger.transparentize(80%)
        : Theme.surface-3;
    border-width: 1px;
    border-color: root.primary && root.enabled ? transparent
        : root.danger ? Theme.danger.transparentize(40%)
        : touch.has-hover ? Theme.border-hover
        : Theme.border-strong;
    opacity: root.enabled ? 1 : 0.45;

    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: Theme.pad;
        spacing: 8px;
        alignment: center;
        if root.icon-line != "" || root.icon-solid != "": Icon {
            y: (parent.height - self.height) / 2;
            width: 22px;
            height: 22px;
            line: root.icon-line;
            solid: root.icon-solid;
            weight: 1.8;
            tint: root.primary && root.enabled ? Theme.on-paint
                : root.danger ? Theme.danger.brighter(30%)
                : Theme.text;
        }
        if root.icon != "": Text {
            text: root.icon;
            font-size: Theme.font-large;
            vertical-alignment: center;
            color: root.primary && root.enabled ? Theme.on-paint : Theme.text;
        }
        if root.text != "": Text {
            text: root.text;
            font-size: Theme.font;
            font-weight: root.primary ? Theme.regular : Theme.light;
            vertical-alignment: center;
            // Long labels are cut short with "…" rather than drawn outside
            // the button.
            overflow: elide;
            color: root.primary && root.enabled ? Theme.on-paint : Theme.text;
        }
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// An on/off switch with a large hit area.
export component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    in property <string> tip;
    callback toggled(bool);

    width: 72px;
    height: Theme.touch;

    track := Rectangle {
        width: 60px;
        height: 32px;
        border-radius: 16px;
        background: root.checked ? Theme.paint : Theme.track;
        border-width: 1px;
        border-color: root.checked ? transparent : Theme.border-strong;
        opacity: root.enabled ? 1 : 0.4;
        knob := Rectangle {
            width: 26px;
            height: 26px;
            y: 3px;
            x: root.checked ? parent.width - self.width - 3px : 3px;
            border-radius: 13px;
            background: root.checked ? Theme.on-paint : Theme.text-dim;
            animate x { duration: 120ms; easing: ease-out; }
        }
    }

    toggle-touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled(root.checked);
        }
    }
    Tip {
        text: root.tip;
        hover: toggle-touch.has-hover;
        pressed: toggle-touch.pressed;
    }
}

export component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    in property <string> tip;
    callback clicked;

    height: 44px;
    preferred-width: label.preferred-width + 28px;
    min-width: min(label.preferred-width + 28px, 72px);
    horizontal-stretch: 0;
    border-radius: 22px;
    background: root.selected ? Theme.paint : touch.pressed ? Theme.pressed : Theme.surface-2;
    border-width: 1px;
    border-color: root.selected ? transparent : touch.has-hover ? Theme.border-hover : Theme.border-strong;

    label := Text {
        x: 14px;
        width: parent.width - 28px;
        text: root.text;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        color: root.selected ? Theme.on-paint : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// A vertical stereo peak meter.
export component StereoMeter inherits Rectangle {
    in property <float> left;
    in property <float> right;
    in property <string> label;
    in property <string> tip;
    width: 30px;

    meter-touch := TouchArea { }
    Tip {
        text: root.tip;
        hover: meter-touch.has-hover;
    }

    VerticalLayout {
        spacing: 4px;
        HorizontalLayout {
            spacing: 3px;
            for level in [root.left, root.right]: Rectangle {
                background: Theme.track;
                border-radius: 3px;
                clip: true;
                Rectangle {
                    y: parent.height - self.height;
                    height: parent.height * min(1, level);
                    background: level >= 0.99 ? Theme.danger : level > 0.7 ? Theme.warn : Theme.ok;
                }
            }
        }
        Text {
            text: root.label;
            font-size: 13px;
            font-weight: Theme.regular;
            color: Theme.text-dim;
            horizontal-alignment: center;
        }
    }
}

export component SectionTitle inherits Text {
    font-size: Theme.font-small;
    font-weight: Theme.regular;
    color: Theme.text-dim;
    letter-spacing: 1.5px;
}

// A row with a label on the left and arbitrary content on the right.
export component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> detail;
    min-height: Theme.touch + 8px;

    HorizontalLayout {
        spacing: Theme.pad;
        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-size: Theme.font;
                color: Theme.text;
                wrap: word-wrap;
            }
            if root.detail != "": Text {
                text: root.detail;
                font-size: Theme.font-small;
                font-weight: Theme.regular;
                color: Theme.text-dim;
                wrap: word-wrap;
            }
        }
        @children
    }
}

// A segmented picker: one big button per option.
export component Segmented inherits HorizontalLayout {
    in property <[string]> options;
    in property <int> selected;
    in property <[string]> tips;
    callback picked(int);
    spacing: 6px;
    for opt[i] in root.options: Chip {
        text: opt;
        selected: i == root.selected;
        tip: i < root.tips.length ? root.tips[i] : "";
        clicked => { root.picked(i); }
    }
}

// Horizontal slider with a large thumb, for the generic parameter page.
export component BigSlider inherits Rectangle {
    in property <float> minimum: 0;
    in property <float> maximum: 1;
    in-out property <float> value;
    // A double click or double tap puts the slider back to this value.
    in property <bool> has-default: false;
    in property <float> default-value;
    in property <string> tip;
    callback changed(float);
    height: Theme.touch;

    property <float> fraction: root.maximum > root.minimum ? (root.value - root.minimum) / (root.maximum - root.minimum) : 0;

    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 10px;
        border-radius: 5px;
        background: Theme.track;
        Rectangle {
            x: 0;
            width: parent.width * root.fraction;
            border-radius: 5px;
            background: Theme.paint;
        }
    }
    Rectangle {
        x: (root.width - self.width) * root.fraction;
        y: (root.height - self.height) / 2;
        width: 36px;
        height: 36px;
        border-radius: 18px;
        background: touch.pressed ? Theme.accent : Theme.text;
        border-width: 1px;
        border-color: #00000080;
    }
    touch := TouchArea {
        function set-from(x: length) {
            root.value = root.minimum + max(0, min(1, x / root.width)) * (root.maximum - root.minimum);
            root.changed(root.value);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.set-from(self.mouse-x);
            }
        }
        moved => { self.set-from(self.mouse-x); }
        double-clicked => {
            if root.has-default {
                root.value = root.default-value;
                root.changed(root.value);
            }
        }
    }
    Tip {
        text: root.tip != "" && root.has-default ? root.tip + " Double-click to reset." : root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// A small round button that folds a panel (or the keyboard) away.
export component CollapseButton inherits Rectangle {
    in property <string> icon;
    in property <string> tip;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? Theme.pressed : transparent;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-hover : Theme.border-strong;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        line: root.icon;
        tint: touch.pressed || touch.has-hover ? Theme.text : Theme.text-dim;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// A small round button with an icon only (its tip says what it does).
export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> icon-solid;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;
    width: 44px;
    height: 44px;
    border-radius: 22px;
    background: touch.pressed ? (root.danger ? Theme.danger.darker(20%) : Theme.pressed)
        : touch.has-hover && root.danger ? Theme.danger.transparentize(30%)
        : transparent;
    border-width: 1px;
    border-color: root.danger ? Theme.danger.transparentize(touch.has-hover ? 0% : 50%)
        : touch.has-hover ? Theme.border-hover : Theme.border-strong;
    Icon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        line: root.icon;
        solid: root.icon-solid;
        weight: 1.8;
        tint: root.danger && (touch.pressed || touch.has-hover) ? #ffffff
            : root.danger ? Theme.danger.brighter(30%)
            : touch.pressed || touch.has-hover ? Theme.text : Theme.text-dim;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// One choice out of several: a button showing the current one, which opens
// a list to pick from (so long lists do not fill the screen).
export component Dropdown inherits Rectangle {
    in property <[string]> options;
    in property <string> selected;
    in property <string> empty-text: "None available";
    // Show MIDI port names shortened (TextUtil.port-label).
    in property <bool> ports;
    // Hover help on the button and on every row, followed by the row's name.
    in property <string> tip;
    callback picked(string);

    property <length> item-height: 48px;
    property <bool> enabled: root.options.length > 0;

    height: 48px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : Theme.surface-2;
    border-width: 1px;
    border-color: touch.has-hover && root.enabled ? Theme.border-hover : Theme.border-strong;

    Text {
        x: Theme.pad;
        width: parent.width - 2 * Theme.pad - 28px;
        text: !root.enabled ? root.empty-text
            : root.selected == "" ? "Choose…"
            : root.ports ? TextUtil.port-label(root.selected) : root.selected;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        color: root.enabled && root.selected != "" ? Theme.text : Theme.text-faint;
        vertical-alignment: center;
        overflow: elide;
    }
    if root.enabled: Icon {
        x: parent.width - Theme.pad - self.width;
        y: (parent.height - self.height) / 2;
        width: 22px;
        height: 22px;
        line: Icons.chevron-down;
        tint: Theme.text-dim;
    }
    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    Tip {
        text: root.selected == "" ? root.tip : root.tip + ": " + root.selected;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }

    popup := PopupWindow {
        x: 0;
        y: root.height + 4px;
        width: root.width;
        height: min(root.options.length * (root.item-height + 4px) + 8px, 340px);
        close-policy: close-on-click-outside;
        Rectangle {
            border-radius: Theme.radius;
            background: Theme.popup.with-alpha(1);
            border-width: 1px;
            border-color: Theme.border-hover;
            clip: true;
            Flickable {
                x: 4px;
                y: 4px;
                width: parent.width - 8px;
                height: parent.height - 8px;
                content-height: root.options.length * (root.item-height + 4px) - 4px;
                interactive: self.content-height > self.height;
                for o[i] in root.options: Rectangle {
                    y: i * (root.item-height + 4px);
                    height: root.item-height;
                    border-radius: Theme.radius - 2px;
                    background: o == root.selected ? Theme.paint : row-touch.pressed ? Theme.pressed : row-touch.has-hover ? Theme.surface-2 : transparent;
                    Text {
                        x: Theme.pad;
                        width: parent.width - 2 * Theme.pad;
                        text: root.ports ? TextUtil.port-label(o) : o;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        color: o == root.selected ? Theme.on-paint : Theme.text;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    row-touch := TouchArea {
                        clicked => {
                            popup.close();
                            root.picked(o);
                        }
                    }
                }
            }
        }
    }
}
