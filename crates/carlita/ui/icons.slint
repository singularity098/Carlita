// Carlita's icons: flat line drawings on a 24 × 24 grid, drawn as paths so
// they stay sharp at any size and take the theme's colours (emoji and font
// symbols look different on every system).
//
// An icon is two paths: `line` is stroked (2 units wide, round ends) and
// `solid` is filled (even-odd, so a shape inside another cuts a hole).

export global Icons {
    // Speaker and sound waves.
    out property <string> audio-solid: "M 3 9 L 7 9 L 12 4.5 L 12 19.5 L 7 15 L 3 15 Z";
    out property <string> audio-line: "M 15.5 8.8 A 4.5 4.5 0 0 1 15.5 15.2 M 18.4 5.8 A 8.6 8.6 0 0 1 18.4 18.2";
    // A floppy disk: body with the shutter and the label cut out.
    out property <string> presets-solid: "M 5 3 L 16.5 3 L 21 7.5 L 21 19 A 2 2 0 0 1 19 21 L 5 21 A 2 2 0 0 1 3 19 L 3 5 A 2 2 0 0 1 5 3 Z M 7.5 4.8 L 7.5 8.6 L 14.5 8.6 L 14.5 4.8 Z M 6.5 12.5 L 6.5 19.2 L 17.5 19.2 L 17.5 12.5 Z";
    out property <string> presets-line: "";
    // Three piano keys with two black keys.
    out property <string> midi-solid: "M 7.6 5 L 10.6 5 L 10.6 13 L 7.6 13 Z M 13.4 5 L 16.4 5 L 16.4 13 L 13.4 13 Z";
    out property <string> midi-line: "M 5 4 L 19 4 A 2 2 0 0 1 21 6 L 21 18 A 2 2 0 0 1 19 20 L 5 20 A 2 2 0 0 1 3 18 L 3 6 A 2 2 0 0 1 5 4 Z M 9.1 13 L 9.1 20 M 14.9 13 L 14.9 20";
    // Three arcs over a dot.
    out property <string> wifi-solid: "M 12 17.6 A 1.6 1.6 0 1 1 11.99 17.6 Z";
    out property <string> wifi-line: "M 2 9 A 15 15 0 0 1 22 9 M 5.2 12.4 A 10.4 10.4 0 0 1 18.8 12.4 M 8.5 15.7 A 5.6 5.6 0 0 1 15.5 15.7";
    // The Bluetooth rune.
    out property <string> bluetooth-solid: "";
    out property <string> bluetooth-line: "M 6.5 7 L 17 16.5 L 12 21 L 12 3 L 17 7.5 L 6.5 17";
    // A monitor on a stand.
    out property <string> display-solid: "";
    out property <string> display-line: "M 4 4 L 20 4 A 1.5 1.5 0 0 1 21.5 5.5 L 21.5 15.5 A 1.5 1.5 0 0 1 20 17 L 4 17 A 1.5 1.5 0 0 1 2.5 15.5 L 2.5 5.5 A 1.5 1.5 0 0 1 4 4 Z M 12 17 L 12 20.5 M 8 20.5 L 16 20.5";
    // A gear.
    out property <string> system-solid: "";
    out property <string> system-line: "M 18.98 9.53 L 21.39 10.00 L 21.39 14.00 L 18.98 14.47 L 18.68 15.19 L 20.05 17.22 L 17.22 20.05 L 15.19 18.68 L 14.47 18.98 L 14.00 21.39 L 10.00 21.39 L 9.53 18.98 L 8.81 18.68 L 6.78 20.05 L 3.95 17.22 L 5.32 15.19 L 5.02 14.47 L 2.61 14.00 L 2.61 10.00 L 5.02 9.53 L 5.32 8.81 L 3.95 6.78 L 6.78 3.95 L 8.81 5.32 L 9.53 5.02 L 10.00 2.61 L 14.00 2.61 L 14.47 5.02 L 15.19 5.32 L 17.22 3.95 L 20.05 6.78 L 18.68 8.81 Z M 15 12 A 3 3 0 1 1 9 12 A 3 3 0 1 1 15 12 Z";
    // Power: a broken ring with a bar.
    out property <string> power-line: "M 17.66 6.6 A 8 8 0 1 1 6.34 6.6 M 12 2.8 L 12 11.5";
    // Three bars (the chain).
    out property <string> menu-line: "M 4 6.5 L 20 6.5 M 4 12 L 20 12 M 4 17.5 L 20 17.5";
    // Chevrons, pointing where the panel goes.
    out property <string> chevron-left: "M 14.5 5.5 L 8 12 L 14.5 18.5";
    out property <string> chevron-right: "M 9.5 5.5 L 16 12 L 9.5 18.5";
    out property <string> chevron-down: "M 5.5 9.5 L 12 16 L 18.5 9.5";
    out property <string> chevron-up: "M 5.5 14.5 L 12 8 L 18.5 14.5";
    out property <string> close: "M 6.5 6.5 L 17.5 17.5 M 17.5 6.5 L 6.5 17.5";
    // A bin with a lid.
    out property <string> trash-line: "M 4 6.5 L 20 6.5 M 9.5 6.5 L 9.5 4 L 14.5 4 L 14.5 6.5 M 6.2 6.5 L 7.2 20 L 16.8 20 L 17.8 6.5 M 10 10.5 L 10 16.5 M 14 10.5 L 14 16.5";
    // A pencil (rename).
    out property <string> pencil-line: "M 15.5 4 L 20 8.5 L 9 19.5 L 4 20 L 4.5 15 Z M 13 6.5 L 17.5 11";
    // A five-pointed star (outline, or filled with `star-solid`).
    out property <string> star-line: "M 12.00 3.20 L 14.41 9.48 L 21.13 9.83 L 15.90 14.07 L 17.64 20.57 L 12.00 16.90 L 6.36 20.57 L 8.10 14.07 L 2.87 9.83 L 9.59 9.48 Z";
    out property <string> star-solid: "M 12.00 3.20 L 14.41 9.48 L 21.13 9.83 L 15.90 14.07 L 17.64 20.57 L 12.00 16.90 L 6.36 20.57 L 8.10 14.07 L 2.87 9.83 L 9.59 9.48 Z";
    // A piano keyboard seen from above (the on-screen keyboard's tab).
    out property <string> keys-solid: "M 6.2 8 L 8.2 8 L 8.2 13 L 6.2 13 Z M 10 8 L 12 8 L 12 13 L 10 13 Z M 15.8 8 L 17.8 8 L 17.8 13 L 15.8 13 Z";
    out property <string> keys-line: "M 3.5 6 L 20.5 6 A 1.5 1.5 0 0 1 22 7.5 L 22 16.5 A 1.5 1.5 0 0 1 20.5 18 L 3.5 18 A 1.5 1.5 0 0 1 2 16.5 L 2 7.5 A 1.5 1.5 0 0 1 3.5 6 Z M 7.2 13 L 7.2 18 M 11 13 L 11 18 M 13.9 13 L 13.9 18 M 16.8 13 L 16.8 18";
}

export component Icon inherits Rectangle {
    in property <string> line;
    in property <string> solid;
    in property <brush> tint: white;
    // Stroke width in grid units (the grid is 24 units across).
    in property <float> weight: 2;
    width: 24px;
    height: 24px;

    if root.solid != "": Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.solid;
        fill: root.tint;
        fill-rule: evenodd;
        stroke-width: 0;
    }
    if root.line != "": Path {
        width: root.width;
        height: root.height;
        viewbox-x: 0;
        viewbox-y: 0;
        viewbox-width: 24;
        viewbox-height: 24;
        commands: root.line;
        fill: transparent;
        stroke: root.tint;
        stroke-width: root.weight * root.width / 24;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
}
