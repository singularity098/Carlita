// Top bar: the track tabs, and the window controls Carlita draws itself
// (the window has no decorations from the window manager). Docked at the
// top in windowed mode; in fullscreen it slides in from the top edge.
import { Theme } from "theme.slint";
import { TrackItem } from "types.slint";
import { Icon, Icons } from "icons.slint";
import { Tip } from "tooltip.slint";
import { Recording } from "options.slint";

component TrackTab inherits Rectangle {
    in property <TrackItem> item;
    // Whether the tab offers to close its track (not the last, empty one).
    in property <bool> closable: true;
    // A tap on a tab that was not selected selects it at once.
    callback pick;
    // A single tap, once it is clear that no second tap follows (the second
    // tap of a double tap renames the tab instead); `was-selected` tells
    // whether the tab was already selected before the tap.
    callback clicked(was-selected: bool);
    callback close;
    // Double click (or double tap) on the name started renaming the tab.
    callback rename-started;
    callback renamed(string);
    // Renaming ended, with or without a new name.
    callback rename-ended;

    // Renaming in place: the name turns into a text field.
    property <bool> editing: false;
    changed editing => {
        if root.editing {
            name-input.text = root.item.name;
            name-input.focus();
            name-input.select-all();
        }
    }
    function start-editing() {
        if root.editing { return; }
        root.editing = true;
        root.rename-started();
    }
    function finish-editing(accept: bool) {
        if !root.editing { return; }
        root.editing = false;
        if accept && name-input.text != root.item.name {
            root.renamed(name-input.text);
        }
        root.rename-ended();
    }

    property <bool> was-selected;
    click-timer := Timer {
        interval: 350ms;
        running: false;
        triggered => {
            self.running = false;
            root.clicked(root.was-selected);
        }
    }

    // The close button keeps its room whether shown or not, so tabs do not
    // move when the mouse comes over one.
    property <bool> show-close: root.closable && (root.item.selected || touch.has-hover || close-touch.has-hover);
    height: 40px;
    min-width: max(96px, row.preferred-width);
    horizontal-stretch: 0;
    border-radius: 10px;
    background: root.item.selected ? Theme.bg : touch.pressed ? Theme.surface-3 : Theme.surface-2;
    border-width: 1px;
    border-color: root.item.selected ? Theme.border : Theme.border.transparentize(40%);
    opacity: root.item.muted && !root.item.selected ? 0.6 : 1;

    // Selected tab: accent line on top, and the bottom corners hidden so the
    // tab runs into the area below.
    if root.item.selected: Rectangle {
        y: parent.height - 10px;
        height: 11px;
        background: Theme.bg;
    }
    if root.item.selected: Rectangle {
        x: 8px;
        width: parent.width - 16px;
        y: 0;
        height: 3px;
        border-radius: 1.5px;
        background: Theme.paint;
    }

    // Under the row, so the close button gets its own taps.
    touch := TouchArea {
        clicked => {
            if root.editing || click-timer.running { return; }
            root.was-selected = root.item.selected;
            if !root.item.selected { root.pick(); }
            click-timer.running = true;
        }
        double-clicked => {
            click-timer.running = false;
            root.start-editing();
        }
    }
    Tip {
        text: root.editing ? "" : root.item.selected
            ? "Tap for this track's chain; double-click to rename it"
            : "Show " + root.item.name + "; double-click to rename it";
        hover: touch.has-hover;
        pressed: touch.pressed;
    }

    row := HorizontalLayout {
        padding-left: 16px;
        padding-right: root.closable ? 6px : 16px;
        spacing: 10px;
        alignment: center;
        if !root.editing: Text {
            text: root.item.name;
            font-size: Theme.font;
            font-weight: Theme.regular;
            color: root.item.selected ? Theme.text : Theme.text-dim;
            vertical-alignment: center;
            overflow: elide;
            max-width: 180px;
        }
        Rectangle {
            visible: root.editing;
            width: root.editing ? 180px : 0;
            height: 30px;
            y: (parent.height - self.height) / 2;
            border-radius: 6px;
            background: Theme.surface;
            border-width: root.editing ? 1px : 0;
            border-color: Theme.paint;
            name-input := TextInput {
                x: 8px;
                width: parent.width - 16px;
                enabled: root.editing;
                text: root.item.name;
                font-size: Theme.font;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                accepted => { root.finish-editing(true); }
                key-pressed(e) => {
                    if e.text == Key.Escape {
                        root.finish-editing(false);
                        return accept;
                    }
                    reject
                }
                // Clicking elsewhere keeps the new name.
                changed has-focus => {
                    if !self.has-focus { root.finish-editing(true); }
                }
            }
        }
        if root.item.muted: Text {
            text: "M";
            font-size: 12px;
            font-weight: Theme.regular;
            color: Theme.warn;
            vertical-alignment: center;
        }
        if !root.item.muted: Rectangle {
            width: 28px;
            height: 5px;
            y: (parent.height - self.height) / 2;
            border-radius: 2.5px;
            background: Theme.surface-3;
            clip: true;
            Rectangle {
                x: 0;
                width: parent.width * min(1, root.item.level);
                background: root.item.level >= 0.99 ? Theme.danger : root.item.level > 0.7 ? Theme.warn : Theme.ok;
            }
        }
        // Close: on the selected tab, and on any tab the mouse is over.
        Rectangle {
            visible: root.closable;
            opacity: root.show-close ? 1 : 0;
            width: root.closable ? 28px : 0;
            height: 28px;
            y: (parent.height - self.height) / 2;
            border-radius: 14px;
            background: close-touch.pressed ? Theme.danger : close-touch.has-hover ? Theme.pressed : transparent;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 14px;
                line: Icons.close;
                weight: 2.4;
                tint: close-touch.pressed ? #fff : close-touch.has-hover ? Theme.text : Theme.text-dim;
            }
            close-touch := TouchArea {
                clicked => { root.close(); }
            }
            Tip {
                text: root.show-close ? "Close " + root.item.name : "";
                hover: close-touch.has-hover;
                pressed: close-touch.pressed;
            }
        }
    }

}

// A window control, its icon drawn on a 14 × 14 grid.
component WindowButton inherits Rectangle {
    // SVG path commands for the icon.
    in property <string> icon;
    in property <bool> danger;
    in property <string> tip;
    callback clicked;
    width: 52px;
    background: touch.pressed ? (root.danger ? Theme.danger.darker(20%) : #ffffff33)
        : touch.has-hover ? (root.danger ? Theme.danger : Theme.pressed)
        : transparent;
    Icon {
        width: 16px;
        height: 16px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        grid: 14;
        // 1.6px at 16px across.
        weight: 1.4;
        line: root.icon;
        tint: root.danger && (touch.has-hover || touch.pressed) ? #fff
            : touch.has-hover || touch.pressed ? Theme.text : Theme.text-dim;
    }
    touch := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
}

// Record / pause and stop, while a recording project is open.
component RecordControl inherits HorizontalLayout {
    spacing: 4px;
    padding-top: 4px;
    padding-bottom: 4px;
    Rectangle {
        width: Recording.state == 0 ? 44px : 108px;
        border-radius: 10px;
        background: rec-touch.pressed ? Theme.surface-3
            : Recording.state == 1 ? Theme.danger.transparentize(75%)
            : transparent;
        border-width: 1px;
        border-color: Recording.state == 0 ? transparent : Theme.danger.transparentize(40%);
        HorizontalLayout {
            alignment: center;
            spacing: 8px;
            // A dot to record, two bars to pause.
            Rectangle {
                width: 14px;
                if Recording.state != 1: Rectangle {
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    background: Recording.available ? Theme.danger : Theme.text-faint;
                }
                if Recording.state == 1: Rectangle {
                    x: 1px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 14px;
                    background: Theme.danger;
                }
                if Recording.state == 1: Rectangle {
                    x: 9px;
                    y: (parent.height - self.height) / 2;
                    width: 4px;
                    height: 14px;
                    background: Theme.danger;
                }
            }
            if Recording.state != 0: Text {
                text: Recording.time;
                font-size: Theme.font-small;
                color: Recording.state == 1 ? Theme.danger : Theme.warn;
                vertical-alignment: center;
            }
        }
        rec-touch := TouchArea {
            enabled: Recording.available;
            clicked => {
                if Recording.state == 1 {
                    Recording.pause();
                } else {
                    Recording.record();
                }
            }
        }
        Tip {
            text: !Recording.available ? Recording.unavailable-text
                : Recording.state == 1 ? "Pause recording"
                : Recording.state == 2 ? "Resume recording"
                : "Record a take into " + Recording.project;
            hover: rec-touch.has-hover;
            pressed: rec-touch.pressed;
        }
    }
    if Recording.state != 0: Rectangle {
        width: 44px;
        border-radius: 10px;
        background: stop-touch.pressed ? Theme.surface-3 : transparent;
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 12px;
            height: 12px;
            border-radius: 2px;
            background: Theme.text;
        }
        stop-touch := TouchArea {
            clicked => { Recording.stop(); }
        }
        Tip {
            text: "Stop: end the take and close its files";
            hover: stop-touch.has-hover;
            pressed: stop-touch.pressed;
        }
    }
}

export component TrackBar inherits Rectangle {
    in property <[TrackItem]> tracks;
    in property <bool> fullscreen;
    in property <bool> maximized;
    // A tab was tapped: `pick-track` at once for a tab that was not
    // selected, `tab-clicked` (with whether it was selected before) a moment
    // later unless a double tap made it a rename.
    callback pick-track(int);
    callback tab-clicked(int, bool);
    callback close-track(int);
    callback rename-track(int, string);
    callback add-track;
    // Windowed: start moving the window, or maximize on a double tap.
    callback start-drag;
    callback toggle-maximize;
    callback minimize;
    callback close-window;
    callback toggle-fullscreen;
    // Fullscreen: swipe the bar back up.
    callback dismiss;
    // A tab's name became a text field.
    callback rename-started(int);
    callback rename-ended;

    background: Theme.surface;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    // The empty part of the bar moves the window (windowed) or is swiped up
    // to hide the bar (fullscreen). The move starts once the pointer has
    // moved a little, so a double click still reaches the bar.
    TouchArea {
        property <bool> dragging;
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                self.dragging = false;
            }
        }
        moved => {
            if root.fullscreen {
                if self.mouse-y - self.pressed-y < -24px {
                    root.dismiss();
                }
            } else if !self.dragging && self.pressed
                && (abs(self.mouse-x - self.pressed-x) > 4px || abs(self.mouse-y - self.pressed-y) > 4px) {
                self.dragging = true;
                root.start-drag();
            }
        }
        double-clicked => {
            if !root.fullscreen {
                root.toggle-maximize();
            }
        }
    }

    HorizontalLayout {
        padding-left: 12px;
        spacing: 6px;

        // Logo.
        Rectangle {
            width: 28px;
            Image {
                width: 24px;
                height: 24px;
                y: (parent.height - self.height) / 2;
                source: @image-url("../../../assets/branding/png/carlita-app-icon-64.png");
            }
        }

        // Tabs, scrolling sideways when there are many tracks.
        Flickable {
            horizontal-stretch: 1;
            content-width: tabs.preferred-width;
            interactive: self.content-width > self.width;
            tabs := HorizontalLayout {
                padding-left: 6px;
                padding-top: root.height - 40px;
                spacing: 6px;
                alignment: start;
                for t in root.tracks: TrackTab {
                    item: t;
                    closable: root.tracks.length > 1;
                    pick => { root.pick-track(t.id); }
                    clicked(was-selected) => { root.tab-clicked(t.id, was-selected); }
                    close => { root.close-track(t.id); }
                    rename-started => { root.rename-started(t.id); }
                    renamed(name) => { root.rename-track(t.id, name); }
                    rename-ended => { root.rename-ended(); }
                }
                Rectangle {
                    width: 48px;
                    height: 40px;
                    border-radius: 10px;
                    background: add-touch.pressed ? Theme.surface-3 : transparent;
                    Text {
                        text: "+";
                        font-size: 24px;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    add-touch := TouchArea {
                        clicked => { root.add-track(); }
                    }
                    Tip {
                        text: "Add a track";
                        hover: add-touch.has-hover;
                        pressed: add-touch.pressed;
                    }
                }
                // Leaves room to grab the bar after the last tab.
                Rectangle {
                    width: 40px;
                }
            }
        }

        if Recording.project != "": RecordControl { }

        // The same window controls in a window and in fullscreen; in
        // fullscreen there is also a button that hides the bar again.
        if root.fullscreen: WindowButton {
            icon: "M 3 9 L 7 5 L 11 9";
            tip: "Hide this bar";
            clicked => { root.dismiss(); }
        }
        WindowButton {
            icon: root.fullscreen
                // Leave fullscreen: corners pointing inwards.
                ? "M 5.5 2.5 L 5.5 5.5 L 2.5 5.5 M 11.5 5.5 L 8.5 5.5 L 8.5 2.5 M 8.5 11.5 L 8.5 8.5 L 11.5 8.5 M 2.5 8.5 L 5.5 8.5 L 5.5 11.5"
                : "M 2.5 5.5 L 2.5 2.5 L 5.5 2.5 M 8.5 2.5 L 11.5 2.5 L 11.5 5.5 M 11.5 8.5 L 11.5 11.5 L 8.5 11.5 M 5.5 11.5 L 2.5 11.5 L 2.5 8.5";
            tip: root.fullscreen ? "Leave fullscreen (F11)" : "Fullscreen (F11)";
            clicked => { root.toggle-fullscreen(); }
        }
        WindowButton {
            icon: "M 3 7.5 L 11 7.5";
            tip: "Minimize";
            clicked => { root.minimize(); }
        }
        WindowButton {
            // In fullscreen this leaves fullscreen for a maximized window.
            icon: root.maximized && !root.fullscreen ? "M 3 5 L 9 5 L 9 11 L 3 11 Z M 5 5 L 5 3 L 11 3 L 11 9 L 9 9" : "M 3 3 L 11 3 L 11 11 L 3 11 Z";
            tip: root.fullscreen ? "Leave fullscreen for a maximized window" : root.maximized ? "Restore" : "Maximize";
            clicked => { root.toggle-maximize(); }
        }
        WindowButton {
            icon: "M 3.5 3.5 L 10.5 10.5 M 10.5 3.5 L 3.5 10.5";
            danger: true;
            tip: "Quit Carlita";
            clicked => { root.close-window(); }
        }
    }
}
