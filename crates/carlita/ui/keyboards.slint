// On-screen keyboards: a QWERTY keyboard for text entry and a piano.
import { Theme } from "theme.slint";
import { BigButton, CollapseButton, TextUtil } from "widgets.slint";
import { Icons } from "icons.slint";

export { TextUtil }

component Key inherits Rectangle {
    in property <string> label;
    in property <bool> wide: false;
    in property <bool> active: false;
    callback pressed;
    min-height: 54px;
    horizontal-stretch: root.wide ? 2 : 1;
    border-radius: 8px;
    background: touch.pressed || root.active ? Theme.paint : Theme.surface-3;
    border-width: 1px;
    border-color: touch.pressed || root.active ? transparent : Theme.border-strong;
    Text {
        text: root.label;
        font-size: Theme.font-large;
        color: touch.pressed || root.active ? Theme.on-paint : Theme.text;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        pointer-event(e) => {
            if e.kind == PointerEventKind.down {
                root.pressed();
            }
        }
    }
}

export component TextKeyboard inherits Rectangle {
    property <bool> shift: false;
    property <bool> symbols: false;
    // A key was typed (`backspace` for ⌫).
    callback typed(text: string, backspace: bool);
    callback done;

    background: transparent;
    property <[[string]]> letters: [
        ["q", "w", "e", "r", "t", "y", "u", "i", "o", "p"],
        ["a", "s", "d", "f", "g", "h", "j", "k", "l"],
        ["z", "x", "c", "v", "b", "n", "m", "-", "_"],
    ];
    property <[[string]]> syms: [
        ["1", "2", "3", "4", "5", "6", "7", "8", "9", "0"],
        ["!", "@", "#", "$", "%", "&", "*", "(", ")"],
        [".", ",", "?", "'", "\"", ":", ";", "/", "+"],
    ];

    function emit(k: string) {
        root.typed(root.shift && !root.symbols ? k.to-uppercase() : k, false);
        if root.shift {
            root.shift = false;
        }
    }

    VerticalLayout {
        padding: 8px;
        spacing: 6px;
        for row in (root.symbols ? root.syms : root.letters): HorizontalLayout {
            spacing: 6px;
            for k in row: Key {
                label: root.shift && !root.symbols ? k.to-uppercase() : k;
                pressed => { root.emit(k); }
            }
        }
        HorizontalLayout {
            spacing: 6px;
            Key {
                label: "⇧";
                active: root.shift;
                pressed => { root.shift = !root.shift; }
            }
            Key {
                label: root.symbols ? "abc" : "123";
                pressed => { root.symbols = !root.symbols; }
            }
            Key {
                label: "space";
                wide: true;
                horizontal-stretch: 4;
                pressed => { root.emit(" "); }
            }
            Key {
                label: "⌫";
                pressed => { root.typed("", true); }
            }
            Key {
                label: "Done";
                wide: true;
                pressed => { root.done(); }
            }
        }
    }

}

// Modal text prompt with an on-screen keyboard (WiFi password, preset names).
export component TextPrompt inherits Rectangle {
    in property <string> title;
    in property <bool> secret;
    in-out property <string> text;
    callback accepted(string);
    callback cancelled;

    // A hardware keyboard types into the field directly, with the usual
    // editing keys (Ctrl+arrows, Ctrl+Backspace, Ctrl+A, Home/End, Shift to
    // select, the clipboard); the on-screen keys type at its cursor.
    init => {
        input.focus();
        input.select-all();
    }
    function type(t: string, backspace: bool) {
        let anchor = input.anchor-position-byte-offset;
        let cursor = input.cursor-position-byte-offset;
        let at = TextUtil.edit-cursor(root.text, anchor, cursor, t, backspace);
        root.text = TextUtil.edit(root.text, anchor, cursor, t, backspace);
        input.set-selection-offsets(at, at);
        input.focus();
    }

    background: Theme.scrim;
    TouchArea { }

    VerticalLayout {
        alignment: end;
        Rectangle {
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: Theme.pad;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 10px;
                    VerticalLayout {
                        horizontal-stretch: 1;
                        spacing: 6px;
                        Text {
                            text: root.title;
                            font-size: Theme.font-large;
                            color: Theme.text;
                        }
                        Rectangle {
                            height: Theme.touch;
                            border-radius: Theme.radius;
                            background: Theme.surface;
                            border-width: 2px;
                            border-color: Theme.paint;
                            input := TextInput {
                                x: Theme.pad;
                                width: parent.width - 2 * Theme.pad;
                                text <=> root.text;
                                input-type: root.secret ? InputType.password : InputType.text;
                                single-line: true;
                                font-size: Theme.font-large;
                                color: Theme.text;
                                selection-background-color: Theme.paint.transparentize(50%);
                                selection-foreground-color: Theme.text;
                                vertical-alignment: center;
                                accepted => { root.accepted(root.text); }
                                key-pressed(e) => {
                                    if e.text == Key.Escape {
                                        root.cancelled();
                                        return accept;
                                    }
                                    reject
                                }
                            }
                        }
                    }
                    VerticalLayout {
                        alignment: end;
                        HorizontalLayout {
                            spacing: 8px;
                            BigButton {
                                text: "Cancel";
                                clicked => { root.cancelled(); }
                            }
                            BigButton {
                                text: "OK";
                                primary: true;
                                clicked => { root.accepted(root.text); }
                            }
                        }
                    }
                }
                TextKeyboard {
                    height: 280px;
                    typed(t, backspace) => { root.type(t, backspace); }
                    done => { root.accepted(root.text); }
                }
            }
        }
    }
}

// Piano keyboard for sending notes to the plugins. Sliding a finger (or the
// held mouse) across the keys plays each key it passes over.
export component Piano inherits Rectangle {
    in property <int> base-note: 48;
    in property <int> octaves: 3;
    callback note(int, bool);
    callback octave(int);
    // Fold the keyboard away.
    callback close;

    background: Theme.popup;
    border-width: 1px;
    border-color: Theme.border;

    // Semitone offsets of white keys and positions of black keys.
    property <[int]> whites: [0, 2, 4, 5, 7, 9, 11];
    property <[{offset: int, slot: int}]> blacks: [
        { offset: 1, slot: 0 }, { offset: 3, slot: 1 }, { offset: 6, slot: 3 }, { offset: 8, slot: 4 }, { offset: 10, slot: 5 },
    ];
    // Black key slot (0..6) of each white key's right edge, or -1.
    property <[int]> black-after: [1, 3, -1, 6, 8, 10, -1];
    // The note held down, or -1.
    property <int> held: -1;

    HorizontalLayout {
        padding: 6px;
        spacing: 6px;
        VerticalLayout {
            width: 64px;
            spacing: 6px;
            BigButton {
                text: "+";
                tip: "One octave up";
                vertical-stretch: 1;
                clicked => { root.octave(1); }
            }
            // The octave the keyboard starts at; + and − move it.
            Text {
                text: "Oct C" + floor(root.base-note / 12 - 1);
                color: Theme.text-dim;
                horizontal-alignment: center;
                font-size: Theme.font-small;
                font-weight: Theme.regular;
            }
            BigButton {
                text: "−";
                tip: "One octave down";
                vertical-stretch: 1;
                clicked => { root.octave(-1); }
            }
        }
        keys := Rectangle {
            property <length> white-w: self.width / (root.octaves * 7);
            property <length> black-w: self.white-w * 0.62;
            property <length> black-h: self.height * 0.6;

            // The note under a point of the keys, or -1.
            pure function note-at(x: length, y: length) -> int {
                if x < 0 || x >= self.width || y < 0 || y >= self.height {
                    return -1;
                }
                // Which white key, and where in it.
                let w = floor(x / self.white-w);
                let oct = floor(w / 7);
                let i = mod(w, 7);
                let within = x - w * self.white-w;
                if y < self.black-h {
                    // A black key straddles the edge between two white keys.
                    if within > self.white-w - self.black-w / 2 && root.black-after[i] >= 0 {
                        return root.base-note + oct * 12 + root.black-after[i];
                    }
                    if within < self.black-w / 2 && i > 0 && root.black-after[i - 1] >= 0 {
                        return root.base-note + oct * 12 + root.black-after[i - 1];
                    }
                }
                return root.base-note + oct * 12 + root.whites[i];
            }

            for oct in root.octaves: Rectangle {
                x: oct * 7 * keys.white-w;
                width: 7 * keys.white-w;
                for w[i] in root.whites: Rectangle {
                    x: i * keys.white-w;
                    width: keys.white-w - 2px;
                    border-radius: 4px;
                    background: root.held == root.base-note + oct * 12 + w ? Theme.paint : #d4d4d8;
                }
                for b in root.blacks: Rectangle {
                    x: (b.slot + 1) * keys.white-w - self.width / 2;
                    width: keys.black-w;
                    height: keys.black-h;
                    y: 0;
                    border-radius: 4px;
                    background: root.held == root.base-note + oct * 12 + b.offset ? Theme.paint : #0c0c0e;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                }
            }

            // One touch area for all keys, so a slide moves from key to key.
            touch := TouchArea {
                function play(n: int) {
                    if n == root.held {
                        return;
                    }
                    if root.held >= 0 {
                        root.note(root.held, false);
                    }
                    root.held = n;
                    if n >= 0 {
                        root.note(n, true);
                    }
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
                        self.play(keys.note-at(self.mouse-x, self.mouse-y));
                    } else if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                        self.play(-1);
                    }
                }
                moved => {
                    if self.pressed {
                        self.play(keys.note-at(self.mouse-x, self.mouse-y));
                    }
                }
            }
        }
        VerticalLayout {
            width: 44px;
            alignment: start;
            CollapseButton {
                icon: Icons.chevron-down;
                tip: "Hide the keyboard";
                clicked => { root.close(); }
            }
        }
    }
}
