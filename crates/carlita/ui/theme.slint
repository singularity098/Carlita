// Carlita's dark, high-contrast stage theme.

export global Theme {
    out property <color> bg: #0c0d10;
    out property <color> surface: #16181d;
    out property <color> surface-2: #1f2229;
    out property <color> surface-3: #2a2e37;
    out property <color> border: #343946;
    out property <color> text: #f2f4f8;
    out property <color> text-dim: #a4abba;
    out property <color> text-faint: #6c7383;
    out property <color> accent: #ff8a1f;
    out property <color> accent-dim: #8a4a12;
    out property <color> ok: #3ddc84;
    out property <color> warn: #ffc53d;
    out property <color> danger: #ff4d5e;
    out property <color> bypassed: #4b5160;
    out property <color> scrim: #000000a0;

    // At least ~10 mm on a 12" 1280x800 panel.
    out property <length> touch: 52px;
    out property <length> row: 68px;
    out property <length> radius: 12px;
    out property <length> pad: 14px;
    out property <length> font-small: 13px;
    out property <length> font: 16px;
    out property <length> font-large: 20px;
    out property <length> font-title: 24px;

    out property <duration> slide: 220ms;
}
