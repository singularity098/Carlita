// Left sidebar: the chain of the selected track (tracks are picked in the
// top bar).
import { Theme } from "theme.slint";
import { BigButton, BigSlider, Chip, StereoMeter, CollapseButton, Tip, SectionTitle, SettingRow, Toggle } from "widgets.slint";
import { Icon, Icons } from "icons.slint";
import { SlotItem, IoChoice } from "types.slint";

// What feeds the selected track: hardware inputs and MIDI devices.
export global TrackIo {
    // Short texts for the track's buttons ("In 1+2", "All MIDI").
    in property <string> input-label;
    in property <string> midi-label;
    // Every hardware input channel, and whether the track takes it.
    in property <[IoChoice]> inputs;
    // Every MIDI device, and whether the track takes it.
    in property <[IoChoice]> midi;
    // The track takes every MIDI device, also ones plugged in later.
    in property <bool> midi-all;
    // MIDI devices cannot be told apart (not under JACK).
    in property <bool> merged-midi;
    // Whether each hardware input hears something now (while probing).
    in property <[bool]> signal;
    // The input page opened or closed: meter the inputs one by one while
    // it is open.
    callback probe(bool);
    callback toggle-input(int);
    callback toggle-midi(int);
    callback set-midi-all(bool);
}

// Picks the hardware inputs and MIDI devices of the selected track.
component TrackIoPage inherits Rectangle {
    in property <string> track-name;
    callback close;

    // Opaque, so the chain underneath does not show through.
    background: Theme.popup.with-alpha(1);
    // Keeps touches from reaching the chain underneath.
    TouchArea {
        moved => {
            if self.mouse-x - self.pressed-x < -60px {
                root.close();
            }
        }
    }

    VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;
        HorizontalLayout {
            spacing: 10px;
            Text {
                text: root.track-name + ": inputs";
                font-size: Theme.font-title;
                color: Theme.text;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            CollapseButton {
                icon: Icons.chevron-left;
                tip: "Back to the chain";
                clicked => { root.close(); }
            }
        }
        Flickable {
            vertical-stretch: 1;
            content-height: column.preferred-height;
            interactive: self.content-height > self.height;
            column := VerticalLayout {
                spacing: 8px;
                alignment: start;
                SectionTitle { text: "AUDIO INPUTS"; }
                Text {
                    text: TrackIo.inputs.length == 0
                        ? "No audio inputs found. Start the audio engine, or pick an input device in the options."
                        : "One input plays on both sides, two make a stereo pair. Pick none for a synth. An input lights up while it hears something: play to see where your instrument comes in.";
                    font-size: Theme.font-small;
                    font-weight: Theme.regular;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                inputs-grid := Rectangle {
                    property <int> per-row: max(1, floor((self.width + 8px) / 72px));
                    property <length> cell: (self.width - (self.per-row - 1) * 8px) / self.per-row;
                    height: TrackIo.inputs.length == 0 ? 0 : ceil(TrackIo.inputs.length / self.per-row) * 52px;
                    for c[i] in TrackIo.inputs: Rectangle {
                        x: mod(i, inputs-grid.per-row) * (inputs-grid.cell + 8px);
                        y: floor(i / inputs-grid.per-row) * 52px;
                        width: inputs-grid.cell;
                        height: 44px;
                        property <bool> live: TrackIo.signal[i];
                        Chip {
                            width: parent.width;
                            text: c.name;
                            selected: c.on;
                            tip: c.detail;
                            clicked => { TrackIo.toggle-input(i); }
                        }
                        // Lights up while the input hears something.
                        Rectangle {
                            border-radius: 22px;
                            border-width: 2px;
                            border-color: Theme.ok;
                            opacity: live ? 1 : 0;
                            animate opacity { duration: live ? 40ms : 250ms; }
                        }
                        Rectangle {
                            x: parent.width - 18px;
                            y: (parent.height - self.height) / 2;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.ok;
                            opacity: live ? 1 : 0;
                            animate opacity { duration: live ? 40ms : 250ms; }
                        }
                    }
                }
                Rectangle { height: 8px; }
                SectionTitle { text: "MIDI DEVICES"; }
                if TrackIo.merged-midi: Text {
                    text: "Every track takes all MIDI devices. Telling them apart needs the JACK driver (JACK or PipeWire).";
                    font-size: Theme.font-small;
                    font-weight: Theme.regular;
                    color: Theme.text-dim;
                    wrap: word-wrap;
                }
                if !TrackIo.merged-midi: SettingRow {
                    label: "All devices";
                    detail: "Also ones plugged in later";
                    Toggle {
                        tip: "Take every MIDI device";
                        checked: TrackIo.midi-all;
                        toggled(v) => { TrackIo.set-midi-all(v); }
                    }
                }
                if !TrackIo.merged-midi && TrackIo.midi.length == 0: Text {
                    text: "No MIDI devices found.";
                    font-size: Theme.font-small;
                    font-weight: Theme.regular;
                    color: Theme.text-dim;
                }
                if !TrackIo.merged-midi: VerticalLayout {
                    for d[i] in TrackIo.midi: SettingRow {
                        label: d.name;
                        detail: d.detail;
                        Toggle {
                            tip: d.on ? "Stop taking this device" : "Take this device";
                            checked: d.on;
                            toggled(v) => { TrackIo.toggle-midi(i); }
                        }
                    }
                }
            }
        }
    }
}

component ChainRow inherits Rectangle {
    in property <SlotItem> item;
    in property <int> index;
    in property <length> row-height;
    // Index currently being dragged (-1 when none) and its offset.
    in property <int> drag-index: -1;
    callback select(int);
    callback toggle-bypass(int, bool);
    callback remove(int);
    callback drag-moved(int, length);
    callback drag-released(int, length);
    callback split(int);

    height: root.row-height;
    clip: false;

    // Lane guide line for plugins inside a parallel block.
    if root.item.depth > 0: Rectangle {
        x: 10px;
        width: 3px;
        height: root.height;
        background: Theme.paint;
        opacity: 0.5;
    }

    property <length> swipe: 0;
    property <bool> swiping: false;
    property <bool> long-pressed: false;

    property <length> indent: root.item.depth > 0 ? 24px : 0;
    card := Rectangle {
        x: root.indent + root.swipe;
        width: root.width - root.indent;
        height: root.height - 6px;
        y: 3px;
        border-radius: Theme.radius;
        background: Theme.surface-2;
        border-width: root.item.selected ? 2px : 1px;
        border-color: root.item.selected ? Theme.paint : Theme.border-strong;
        opacity: root.swiping ? max(0.3, 1 - abs(root.swipe) / root.width) : 1;
        animate x { duration: root.swiping ? 0ms : 160ms; easing: ease-out; }

        HorizontalLayout {
            padding-right: 6px;
            spacing: 4px;

            // Drag handle for reordering.
            handle := Rectangle {
                width: Theme.touch;
                Text {
                    text: "≡";
                    font-size: 26px;
                    color: handle-touch.pressed ? Theme.accent : Theme.text-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                handle-touch := TouchArea {
                    moved => { root.drag-moved(root.index, self.mouse-y - self.pressed-y); }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                            root.drag-released(root.index, self.mouse-y - self.pressed-y);
                        }
                    }
                }
                Tip {
                    text: "Drag up or down to move this plugin (into a parallel lane too)";
                    hover: handle-touch.has-hover;
                    pressed: handle-touch.pressed;
                }
            }

            // Name; tap selects, swipe sideways or long-press removes.
            body := Rectangle {
                horizontal-stretch: 1;
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    Text {
                        text: root.item.name;
                        font-size: Theme.font;
                        color: root.item.bypassed ? Theme.text-faint : Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: root.item.status == "loading" ? "Loading…"
                            : root.item.status == "failed" ? "Failed to load · passing audio through"
                            : root.item.status == "crashed" ? "Crashed · tap to reload"
                            : root.item.format + "  ·  PDC " + root.item.latency + (root.item.midi-learned ? "  ·  MIDI" : "");
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        color: root.item.status == "failed" || root.item.status == "crashed" ? Theme.danger : Theme.text-dim;
                        overflow: elide;
                    }
                }
                body-touch := TouchArea {
                    moved => {
                        if abs(self.mouse-x - self.pressed-x) > 12px {
                            root.swiping = true;
                        }
                        if root.swiping {
                            root.swipe = self.mouse-x - self.pressed-x;
                        }
                    }
                    pointer-event(e) => {
                        if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                            if root.swiping && abs(root.swipe) > root.width * 0.35 {
                                root.remove(root.item.id);
                            } else if !root.swiping && !root.long-pressed && e.kind == PointerEventKind.up {
                                root.select(root.item.id);
                            }
                            root.swiping = false;
                            root.swipe = 0;
                            root.long-pressed = false;
                        }
                    }
                }
                Tip {
                    text: root.item.status == "crashed" || root.item.status == "failed"
                        ? "Tap to load " + root.item.name + " again"
                        : root.item.selected ? root.item.name + " is shown. Swipe sideways or hold to remove it."
                        : "Show " + root.item.name + ". Swipe sideways or hold to remove it.";
                    hover: body-touch.has-hover;
                    pressed: body-touch.pressed;
                }
                Timer {
                    interval: 650ms;
                    running: body-touch.pressed && !root.swiping && !root.long-pressed;
                    triggered => {
                        root.long-pressed = true;
                        root.remove(root.item.id);
                    }
                }
            }

            // Remove (swiping the row sideways or a long press do it too).
            remove-button := Rectangle {
                width: 44px;
                height: Theme.touch;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius;
                background: remove-touch.pressed ? Theme.danger.transparentize(70%) : transparent;
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 22px;
                    height: 22px;
                    line: Icons.trash-line;
                    weight: 1.8;
                    tint: remove-touch.pressed || remove-touch.has-hover ? Theme.danger : Theme.text-faint;
                }
                remove-touch := TouchArea {
                    clicked => { root.remove(root.item.id); }
                }
                Tip {
                    text: "Remove " + root.item.name + " (Undo brings it back)";
                    hover: remove-touch.has-hover;
                    pressed: remove-touch.pressed;
                }
            }

            // Run this plugin in parallel with a dry lane.
            if root.item.can-split: Rectangle {
                width: 44px;
                height: Theme.touch;
                y: (parent.height - self.height) / 2;
                border-radius: Theme.radius;
                background: split-touch.pressed ? Theme.surface-3 : transparent;
                Text {
                    text: "∥";
                    font-size: 24px;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                split-touch := TouchArea {
                    clicked => { root.split(root.item.id); }
                }
                Tip {
                    text: "Run in parallel: this plugin in one lane, the dry signal in another";
                    hover: split-touch.has-hover;
                    pressed: split-touch.pressed;
                }
            }

            // One-tap bypass.
            bypass := Rectangle {
                width: Theme.touch;
                height: Theme.touch;
                y: (parent.height - self.height) / 2;
                // The circle is a path: its edge is drawn smoother than a
                // rounded rectangle's.
                Path {
                    width: parent.width;
                    height: parent.height;
                    viewbox-x: 0;
                    viewbox-y: 0;
                    viewbox-width: 52;
                    viewbox-height: 52;
                    commands: "M 1 26 A 25 25 0 1 1 51 26 A 25 25 0 1 1 1 26 Z";
                    fill: root.item.bypassed ? Theme.surface-3 : Theme.paint;
                    stroke: root.item.bypassed ? Theme.border-strong : transparent;
                    stroke-width: 1px;
                }
                Icon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 24px;
                    height: 24px;
                    line: Icons.power-line;
                    weight: 2.2;
                    tint: root.item.bypassed ? Theme.text-faint : Theme.on-paint;
                }
                bypass-touch := TouchArea {
                    clicked => { root.toggle-bypass(root.item.id, !root.item.bypassed); }
                }
                Tip {
                    text: root.item.bypassed ? "Bypassed: tap to turn it on" : "On: tap to bypass it";
                    hover: bypass-touch.has-hover;
                    pressed: bypass-touch.pressed;
                }
            }
        }
    }
}

// Header of a parallel block, of one of its lanes, or the row of an empty
// (dry) lane.
component StructureRow inherits Rectangle {
    in property <SlotItem> item;
    callback add-lane;
    callback add-plugin;
    callback remove-lane;

    if root.item.kind == "parallel": Rectangle {
        y: 4px;
        height: root.height - 4px;
        border-radius: Theme.radius;
        background: Theme.surface-2;
        border-width: 1px;
        border-color: Theme.paint;
        HorizontalLayout {
            padding-left: Theme.pad;
            padding-right: 4px;
            spacing: 6px;
            Text {
                text: "∥  " + root.item.label;
                font-size: Theme.font-small;
                font-weight: Theme.regular;
                color: Theme.accent;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Chip {
                y: (parent.height - self.height) / 2;
                text: "+ Lane";
                tip: "Add another lane to this parallel block";
                clicked => { root.add-lane(); }
            }
        }
    }

    if root.item.kind == "lane": HorizontalLayout {
        padding-left: 24px;
        spacing: 6px;
        Text {
            text: root.item.label;
            font-size: Theme.font-small;
            font-weight: Theme.regular;
            color: Theme.text-dim;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 44px;
            Text {
                text: "+";
                font-size: 24px;
                color: lane-add.pressed ? Theme.accent : Theme.text;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            lane-add := TouchArea {
                clicked => { root.add-plugin(); }
            }
            Tip {
                text: "Add a plugin to this lane";
                hover: lane-add.has-hover;
                pressed: lane-add.pressed;
            }
        }
        Rectangle {
            width: 44px;
            Text {
                text: "✕";
                font-size: 18px;
                color: lane-remove.pressed ? Theme.danger : Theme.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            lane-remove := TouchArea {
                clicked => { root.remove-lane(); }
            }
            Tip {
                text: "Remove this lane and its plugins";
                hover: lane-remove.has-hover;
                pressed: lane-remove.pressed;
            }
        }
    }

    if root.item.kind == "dry": Rectangle {
        Rectangle {
            x: 10px;
            width: 3px;
            height: root.height;
            background: Theme.paint;
            opacity: 0.5;
        }
        Rectangle {
            x: 24px;
            y: 3px;
            width: root.width - 24px;
            height: root.height - 6px;
            border-radius: Theme.radius;
            border-width: 1px;
            border-color: Theme.border;
            Text {
                text: "Dry signal  ·  tap + to add a plugin";
                font-size: Theme.font-small;
                color: Theme.text-faint;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }
}

export component ChainPanel inherits Rectangle {
    in property <[SlotItem]> slots;
    in property <float> in-left;
    in property <float> in-right;
    in property <float> out-left;
    in property <float> out-right;
    in property <string> dsp-load;
    in property <string> latency;
    in property <string> preset-name;
    in property <string> undo-text;
    in property <string> track-name;
    in property <bool> track-muted;
    in property <float> track-volume;
    in property <string> track-volume-text;
    in property <float> track-left;
    in property <float> track-right;
    // Where a dragged row would land (set by Rust while dragging).
    in property <length> drop-y: -1px;
    callback select(int);
    callback toggle-bypass(int, bool);
    callback remove(int);
    // Row dragged, and the y of its centre in the list.
    callback drag-hover(int, length);
    callback drag-drop(int);
    callback split(int);
    callback add-lane(int);
    callback remove-lane(int);
    callback add-to-lane(int);
    callback add-plugin;
    callback undo;
    callback close;
    callback rename-track;
    callback delete-track;
    callback toggle-mute;
    callback set-volume(float);

    background: Theme.popup;
    border-width: 1px;
    border-color: Theme.border;

    property <int> drag-index: -1;
    // The page that picks the track's inputs covers the chain.
    property <bool> io-open: false;
    changed io-open => { TrackIo.probe(self.io-open); }
    property <length> drag-offset: 0;
    property <length> content-h: root.slots.length == 0 ? 0 : root.slots[root.slots.length - 1].y + root.slots[root.slots.length - 1].h;

    // Under everything: keeps taps on the panel's empty space from reaching
    // the scrim (which would close the panel). A swipe left still closes it.
    TouchArea {
        moved => {
            if self.mouse-x - self.pressed-x < -60px {
                root.close();
            }
        }
    }

    VerticalLayout {
        padding: Theme.pad;
        spacing: 10px;

        // Header: title, meters and load. Swiping it left closes the panel.
        header := Rectangle {
            height: 96px;
            TouchArea {
                // Swipe-back target under the title (so the title stays tappable),
                // leaving the meters' area free.
                width: parent.width - 130px;
                x: 0;
                moved => {
                    if self.mouse-x - self.pressed-x < -60px {
                        root.close();
                    }
                }
            }
            HorizontalLayout {
                spacing: 10px;
                VerticalLayout {
                    alignment: center;
                    // The track's name; tap to rename it.
                    title := Text {
                        text: root.track-name + "  ✎";
                        font-size: Theme.font-title;
                        color: title-touch.pressed ? Theme.accent : Theme.text;
                        overflow: elide;
                        title-touch := TouchArea {
                            clicked => { root.rename-track(); }
                        }
                        Tip {
                            text: "Rename this track";
                            hover: title-touch.has-hover;
                            pressed: title-touch.pressed;
                        }
                    }
                    Text {
                        text: root.preset-name == "" ? "Unsaved preset" : root.preset-name;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        color: Theme.accent;
                        overflow: elide;
                    }
                    Text {
                        text: "DSP " + root.dsp-load + "   ·   " + root.latency;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        color: Theme.text-dim;
                    }
                }
                StereoMeter {
                    left: root.in-left;
                    right: root.in-right;
                    label: "IN";
                    tip: "Level of the inputs this track takes";
                }
                StereoMeter {
                    left: root.out-left;
                    right: root.out-right;
                    label: "OUT";
                    tip: "Output level";
                }
                VerticalLayout {
                    alignment: start;
                    CollapseButton {
                        icon: Icons.chevron-left;
                        tip: "Close the chain";
                        clicked => { root.close(); }
                    }
                }
            }
        }

        // The selected track: input, mute, volume, level, delete.
        HorizontalLayout {
            height: Theme.touch;
            spacing: 6px;
            Chip {
                y: (parent.height - self.height) / 2;
                text: TrackIo.input-label;
                tip: "Which hardware inputs feed this track";
                clicked => { root.io-open = true; }
            }
            Chip {
                y: (parent.height - self.height) / 2;
                text: TrackIo.midi-label;
                tip: "Which MIDI devices play this track";
                clicked => { root.io-open = true; }
            }
            Chip {
                y: (parent.height - self.height) / 2;
                text: "Mute";
                tip: root.track-muted ? "Muted: tap to hear this track again" : "Silence this track";
                selected: root.track-muted;
                clicked => { root.toggle-mute(); }
            }
            BigSlider {
                horizontal-stretch: 1;
                minimum: 0;
                maximum: 2;
                value: root.track-volume;
                has-default: true;
                default-value: 1;
                tip: "Track volume.";
                changed(v) => { root.set-volume(v); }
            }
            Text {
                width: 58px;
                text: root.track-volume-text;
                font-size: Theme.font-small;
                color: Theme.text-dim;
                vertical-alignment: center;
                horizontal-alignment: right;
            }
            StereoMeter {
                width: 18px;
                left: root.track-left;
                right: root.track-right;
                label: "";
                tip: "Track level";
            }
            Rectangle {
                width: 40px;
                Text {
                    text: "✕";
                    font-size: 18px;
                    color: delete-touch.pressed ? Theme.danger : Theme.text-faint;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                delete-touch := TouchArea {
                    clicked => { root.delete-track(); }
                }
                Tip {
                    text: "Delete this track";
                    hover: delete-touch.has-hover;
                    pressed: delete-touch.pressed;
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            clip: true;

            if root.slots.length == 0: VerticalLayout {
                alignment: center;
                Text {
                    text: "This track is empty.\nAdd a plugin to get started.";
                    horizontal-alignment: center;
                    font-size: Theme.font;
                    color: Theme.text-dim;
                }
            }

            list := Flickable {
                // Room below the last row to drop a plugin at the end.
                content-height: root.content-h + Theme.row;
                interactive: self.content-height > self.height && root.drag-index < 0;
                for slot[i] in root.slots: Rectangle {
                    x: 0;
                    y: slot.y + (i == root.drag-index ? root.drag-offset : 0);
                    z: i == root.drag-index ? 10 : 0;
                    width: list.width;
                    height: slot.h;
                    if slot.kind == "plugin": ChainRow {
                        width: parent.width;
                        item: slot;
                        index: i;
                        row-height: slot.h;
                        drag-index: root.drag-index;
                        select(id) => { root.select(id); }
                        toggle-bypass(id, b) => { root.toggle-bypass(id, b); }
                        remove(id) => { root.remove(id); }
                        split(id) => { root.split(id); }
                        drag-moved(idx, dy) => {
                            root.drag-index = idx;
                            root.drag-offset = dy;
                            root.drag-hover(idx, slot.y + dy + slot.h / 2);
                        }
                        drag-released(idx, dy) => {
                            // Clear the drag first: dropping rebuilds the
                            // list, which ends this row (and this handler)
                            // before anything after the drop would run, and
                            // a leftover offset would shift whatever row
                            // later takes this index.
                            let dragging = root.drag-index >= 0;
                            root.drag-index = -1;
                            root.drag-offset = 0;
                            if dragging {
                                root.drag-drop(idx);
                            }
                        }
                    }
                    if slot.kind != "plugin": StructureRow {
                        width: parent.width;
                        height: parent.height;
                        item: slot;
                        add-lane => { root.add-lane(i); }
                        add-plugin => { root.add-to-lane(i); }
                        remove-lane => { root.remove-lane(i); }
                    }
                }
                // Drop indicator.
                if root.drag-index >= 0 && root.drop-y >= 0: Rectangle {
                    x: 0;
                    width: list.width;
                    height: 4px;
                    border-radius: 2px;
                    background: Theme.paint;
                    y: root.drop-y - 2px;
                }
            }
        }

        if root.undo-text != "": Rectangle {
            height: Theme.touch + 8px;
            border-radius: Theme.radius;
            background: Theme.surface-2;
            border-width: 1px;
            border-color: Theme.border-strong;
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: 6px;
                spacing: 8px;
                Text {
                    text: root.undo-text;
                    color: Theme.text;
                    font-size: Theme.font;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                BigButton {
                    text: "Undo";
                    tip: "Put the removed plugin back";
                    primary: true;
                    clicked => { root.undo(); }
                }
            }
        }

        BigButton {
            text: "Add plugin";
            tip: "Pick a plugin to add to the end of this track";
            icon: "+";
            primary: true;
            height: 60px;
            clicked => { root.add-plugin(); }
        }
    }

    if root.io-open: TrackIoPage {
        width: root.width;
        height: root.height;
        track-name: root.track-name;
        close => { root.io-open = false; }
    }
}
