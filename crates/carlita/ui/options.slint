// Right sidebar: options. Every toggle applies immediately.
import { Theme } from "theme.slint";
import { BigButton, Toggle, Chip, SectionTitle, SettingRow, BigSlider, CollapseButton, Dropdown, IconButton, Tip } from "widgets.slint";
import { WifiItem, BtItem, MappingItem } from "types.slint";
import { Icon, Icons } from "icons.slint";

export global Options {
    // ---- audio
    in property <string> engine-status;
    in property <bool> engine-running;
    in property <string> dsp-load;
    in property <string> latency;
    in property <int> xruns;
    in property <[string]> drivers;
    in property <string> driver;
    in property <[string]> devices;
    in property <string> device;
    in property <[string]> inputs;
    in property <string> input;
    in property <[string]> outputs;
    in property <string> output;
    // How many hardware inputs tracks are offered ("All" or a number).
    in property <[string]> input-counts: ["All"];
    in property <string> input-count: "All";
    in property <[string]> sample-rates: ["44100", "48000", "88200", "96000"];
    in property <string> sample-rate;
    in property <[string]> buffer-sizes: ["32", "64", "128", "256", "512", "1024"];
    in property <string> buffer-size;
    in property <bool> isolate-plugins;
    callback set-driver(string);
    callback set-device(string);
    callback set-input(string);
    callback set-output(string);
    callback set-input-count(string);
    callback set-sample-rate(string);
    callback set-buffer-size(string);
    callback set-isolate(bool);
    callback restart-engine;

    // ---- presets
    in property <[string]> presets;
    in property <string> current-preset;
    in property <string> default-preset;
    callback save-preset;
    callback save-preset-as;
    callback load-preset(string);
    callback rename-preset(string);
    callback delete-preset(string);
    callback set-default-preset(string);

    // ---- midi
    in property <[string]> midi-ports;
    in property <string> midi-port;
    in property <bool> learning;
    in property <string> learn-target;
    in property <int> learn-action; // 0 toggle, 1 follow
    in property <[MappingItem]> mappings;
    callback set-midi-port(string);
    callback start-learn(int);
    callback cancel-learn;
    callback delete-mapping(int);

    // ---- wifi
    in property <bool> wifi-available;
    in property <bool> wifi-enabled;
    in property <[WifiItem]> wifi-networks;
    in property <string> wifi-status;
    callback set-wifi(bool);
    callback scan-wifi;
    callback connect-wifi(string);
    callback disconnect-wifi;

    // ---- bluetooth
    in property <bool> bt-available;
    in property <bool> bt-enabled;
    in property <[BtItem]> bt-devices;
    in property <string> bt-status;
    in property <bool> bt-scanning;
    callback set-bt(bool);
    callback scan-bt(bool);
    callback connect-bt(string);
    callback disconnect-bt(string);
    callback forget-bt(string);

    // ---- display
    in property <bool> fullscreen;
    in property <bool> brightness-available;
    in property <float> brightness;
    in property <string> selected-plugin;
    callback set-fullscreen(bool);
    // Picks a theme by name (Theme.names).
    callback set-theme(string);
    callback set-brightness(float);
    // How large plugin editors are drawn, on top of the desktop's scale.
    in property <[string]> editor-zooms: ["100%", "125%", "150%", "175%", "200%"];
    in property <string> editor-zoom: "100%";
    callback set-editor-zoom(string);

    // ---- keyboard
    in property <bool> keyboard-visible;
    callback set-keyboard(bool);

    // ---- system (the buttons at the top of the panel)
    in property <string> version;
    callback reboot;
    callback shutdown;
    callback quit;
}

component ListRow inherits Rectangle {
    in property <string> title;
    in property <string> subtitle;
    in property <bool> highlight;
    in property <string> tip;
    callback clicked;
    min-height: Theme.row - 8px;
    border-radius: Theme.radius;
    background: touch.pressed ? Theme.pressed : Theme.surface-2;
    border-width: root.highlight ? 2px : 1px;
    border-color: root.highlight ? Theme.paint : touch.has-hover ? Theme.border-hover : Theme.border-strong;
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
    Tip {
        text: root.tip;
        hover: touch.has-hover;
        pressed: touch.pressed;
    }
    // Buttons in the row sit inside its outline, clear of it.
    HorizontalLayout {
        padding-left: Theme.pad;
        padding-right: 8px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                font-size: Theme.font;
                color: Theme.text;
                overflow: elide;
            }
            if root.subtitle != "": Text {
                text: root.subtitle;
                font-size: Theme.font-small;
                font-weight: Theme.regular;
                color: Theme.text-dim;
                overflow: elide;
            }
        }
        @children
    }
}

component AudioPage inherits VerticalLayout {
    spacing: 12px;
    Rectangle {
        border-radius: Theme.radius;
        background: Options.engine-running ? Theme.surface-2 : Theme.danger.transparentize(80%);
        border-width: 1px;
        border-color: Options.engine-running ? Theme.border-strong : Theme.danger.transparentize(40%);
        height: 86px;
        VerticalLayout {
            padding: Theme.pad;
            Text {
                text: Options.engine-status;
                color: Theme.text;
                font-size: Theme.font;
                wrap: word-wrap;
            }
            Text {
                text: "DSP " + Options.dsp-load + "   ·   latency " + Options.latency + "   ·   xruns " + Options.xruns;
                color: Theme.text-dim;
                font-size: Theme.font-small;
                font-weight: Theme.regular;
            }
        }
    }
    SectionTitle { text: "DRIVER"; }
    Dropdown {
        options: Options.drivers;
        selected: Options.driver;
        tip: "The audio system to play through. JACK also works with PipeWire (pipewire-jack).";
        picked(v) => { Options.set-driver(v); }
    }
    if Options.devices.length > 0: SectionTitle { text: "DEVICE"; }
    if Options.devices.length > 0: Dropdown {
        options: Options.devices;
        selected: Options.device;
        tip: "Use this sound card";
        picked(v) => { Options.set-device(v); }
    }
    if Options.inputs.length > 0 || Options.outputs.length > 0: SectionTitle { text: "INPUT DEVICE"; }
    if Options.inputs.length > 0 || Options.outputs.length > 0: Dropdown {
        options: Options.inputs;
        selected: Options.input;
        tip: "Feed the chain from";
        picked(v) => { Options.set-input(v); }
    }
    if Options.inputs.length > 0 || Options.outputs.length > 0: SectionTitle { text: "OUTPUT DEVICE"; }
    if Options.inputs.length > 0 || Options.outputs.length > 0: Dropdown {
        options: Options.outputs;
        selected: Options.output;
        tip: "Play the chain into";
        picked(v) => { Options.set-output(v); }
    }
    SectionTitle { text: "INPUT CHANNELS"; }
    Dropdown {
        options: Options.input-counts;
        selected: Options.input-count;
        tip: "How many inputs your audio interface has. Tracks only offer these, not every port the audio system reports.";
        picked(v) => { Options.set-input-count(v); }
    }
    SectionTitle { text: "SAMPLE RATE"; }
    Dropdown {
        options: Options.sample-rates;
        selected: Options.sample-rate;
        tip: "Samples per second. Higher rates cost more CPU.";
        picked(v) => { Options.set-sample-rate(v); }
    }
    SectionTitle { text: "BUFFER SIZE"; }
    Dropdown {
        options: Options.buffer-sizes;
        selected: Options.buffer-size;
        tip: "Frames per audio block. Smaller is less latency but more CPU; raise it if you hear crackles.";
        picked(v) => { Options.set-buffer-size(v); }
    }
    SettingRow {
        label: "Isolate plugins";
        detail: "Run each plugin in its own process so a crash cannot stop the audio";
        Toggle {
            tip: "Each plugin in its own process. Applies when the engine restarts.";
            checked: Options.isolate-plugins;
            toggled(v) => { Options.set-isolate(v); }
        }
    }
    BigButton {
        text: "Restart audio engine";
        tip: "Stop and start the audio engine with these settings. The chain and its settings are kept.";
        clicked => { Options.restart-engine(); }
    }
}

component PresetsPage inherits VerticalLayout {
    spacing: 12px;
    Text {
        text: Options.current-preset == "" ? "Current chain is not saved" : "Current: " + Options.current-preset;
        color: Theme.accent;
        font-size: Theme.font;
    }
    HorizontalLayout {
        spacing: 8px;
        BigButton {
            text: "Save";
            tip: "Save the current chain over \"" + Options.current-preset + "\"";
            primary: true;
            horizontal-stretch: 1;
            enabled: Options.current-preset != "";
            clicked => { Options.save-preset(); }
        }
        BigButton {
            text: "Save as…";
            tip: "Save the current chain as a new preset";
            horizontal-stretch: 1;
            clicked => { Options.save-preset-as(); }
        }
    }
    SectionTitle { text: "PRESETS"; }
    if Options.presets.length == 0: Text {
        text: "No presets saved yet.";
        color: Theme.text-faint;
    }
    for p in Options.presets: ListRow {
        title: p;
        subtitle: p == Options.default-preset ? "Loads at startup" : "";
        highlight: p == Options.current-preset;
        tip: "Load \"" + p + "\"";
        clicked => { Options.load-preset(p); }
        Rectangle {
            width: Theme.touch;
            Icon {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                line: p == Options.default-preset ? "" : Icons.star-line;
                solid: p == Options.default-preset ? Icons.star-solid : "";
                weight: 1.6;
                tint: p == Options.default-preset ? Theme.warn : Theme.text-faint;
            }
            star-touch := TouchArea {
                clicked => { Options.set-default-preset(p == Options.default-preset ? "" : p); }
            }
            Tip {
                text: p == Options.default-preset ? "Loads when Carlita starts. Tap to stop that." : "Load this preset when Carlita starts";
                hover: star-touch.has-hover;
                pressed: star-touch.pressed;
            }
        }
        BigButton {
            icon-line: Icons.pencil-line;
            tip: "Rename";
            clicked => { Options.rename-preset(p); }
        }
        BigButton {
            icon-line: Icons.trash-line;
            danger: true;
            tip: "Delete";
            clicked => { Options.delete-preset(p); }
        }
    }
}

component MidiPage inherits VerticalLayout {
    spacing: 12px;
    SettingRow {
        label: "On-screen keyboard";
        detail: "Play notes into the selected plugin";
        Toggle {
            tip: "Show or hide the on-screen piano (swiping up from the bottom edge shows it too)";
            checked: Options.keyboard-visible;
            toggled(v) => { Options.set-keyboard(v); }
        }
    }
    SectionTitle { text: "MIDI LEARN"; }
    Text {
        text: Options.selected-plugin == "" ? "Select a plugin in the chain first."
            : Options.learning ? "Move a control or press a footswitch to map it to: " + Options.learn-target
            : "Map a footswitch or controller to bypass \"" + Options.selected-plugin + "\".";
        color: Options.learning ? Theme.accent : Theme.text-dim;
        font-size: Theme.font;
        wrap: word-wrap;
    }
    HorizontalLayout {
        spacing: 8px;
        if !Options.learning: BigButton {
            text: "Learn toggle";
            tip: "Map a footswitch or button: each press turns the selected plugin on or off";
            primary: true;
            horizontal-stretch: 1;
            enabled: Options.selected-plugin != "";
            clicked => { Options.start-learn(0); }
        }
        if !Options.learning: BigButton {
            text: "Learn momentary";
            tip: "Map a footswitch or button: the selected plugin follows it, on while it is held";
            horizontal-stretch: 1;
            enabled: Options.selected-plugin != "";
            clicked => { Options.start-learn(1); }
        }
        if Options.learning: BigButton {
            text: "Cancel";
            tip: "Stop listening for a control";
            horizontal-stretch: 1;
            clicked => { Options.cancel-learn(); }
        }
    }
    for m in Options.mappings: ListRow {
        title: m.trigger + "  →  " + m.plugin;
        subtitle: m.action;
        BigButton {
            icon-line: Icons.trash-line;
            danger: true;
            tip: "Delete this mapping";
            clicked => { Options.delete-mapping(m.index); }
        }
    }
    SectionTitle { text: "MIDI INPUT FOR LEARN"; }
    Dropdown {
        options: Options.midi-ports;
        selected: Options.midi-port;
        empty-text: "No MIDI inputs found";
        ports: true;
        tip: "Listen for MIDI learn on";
        picked(v) => { Options.set-midi-port(v); }
    }
}

component WifiPage inherits VerticalLayout {
    spacing: 12px;
    if !Options.wifi-available: Text {
        text: "No WiFi device found (NetworkManager is required).";
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    if Options.wifi-available: SettingRow {
        label: "WiFi";
        detail: Options.wifi-status;
        Toggle {
            tip: "Turn WiFi on or off";
            checked: Options.wifi-enabled;
            toggled(v) => { Options.set-wifi(v); }
        }
    }
    if Options.wifi-available && Options.wifi-enabled: BigButton {
        text: "Scan for networks";
        tip: "Look for WiFi networks nearby";
        clicked => { Options.scan-wifi(); }
    }
    if Options.wifi-enabled: VerticalLayout {
        spacing: 6px;
        for n in Options.wifi-networks: ListRow {
            title: (n.secured ? "🔒 " : "") + n.ssid;
            subtitle: n.active ? "Connected" : n.known ? "Saved" : "";
            highlight: n.active;
            tip: n.active ? "Connected to " + n.ssid : "Connect to " + n.ssid + (n.secured && !n.known ? " (asks for the password)" : "");
            clicked => { Options.connect-wifi(n.ssid); }
            Text {
                text: n.strength + "%";
                color: Theme.text-dim;
                vertical-alignment: center;
                width: 48px;
            }
            if n.active: BigButton {
                text: "Disconnect";
                tip: "Disconnect from " + n.ssid;
                clicked => { Options.disconnect-wifi(); }
            }
        }
    }
}

component BluetoothPage inherits VerticalLayout {
    spacing: 12px;
    if !Options.bt-available: Text {
        text: "No Bluetooth adapter found (BlueZ is required).";
        color: Theme.text-dim;
        wrap: word-wrap;
    }
    if Options.bt-available: SettingRow {
        label: "Bluetooth";
        detail: Options.bt-status;
        Toggle {
            tip: "Turn Bluetooth on or off";
            checked: Options.bt-enabled;
            toggled(v) => { Options.set-bt(v); }
        }
    }
    if Options.bt-available && Options.bt-enabled: BigButton {
        text: Options.bt-scanning ? "Stop searching" : "Search for devices";
        tip: Options.bt-scanning ? "Stop looking for Bluetooth devices" : "Look for Bluetooth devices nearby (put the device in pairing mode)";
        clicked => { Options.scan-bt(!Options.bt-scanning); }
    }
    if Options.bt-enabled: VerticalLayout {
        spacing: 6px;
        for d in Options.bt-devices: ListRow {
            title: d.name;
            subtitle: d.connected ? "Connected" : d.paired ? "Paired" : "Nearby · tap to pair";
            highlight: d.connected;
            tip: d.connected ? "Disconnect " + d.name : d.paired ? "Connect " + d.name : "Pair with " + d.name;
            clicked => {
                if d.connected {
                    Options.disconnect-bt(d.path);
                } else {
                    Options.connect-bt(d.path);
                }
            }
            if d.paired: BigButton {
                text: "Forget";
                tip: "Remove the pairing with " + d.name;
                clicked => { Options.forget-bt(d.path); }
            }
        }
    }
}

component DisplayPage inherits VerticalLayout {
    spacing: 12px;
    SectionTitle { text: "THEME"; }
    Dropdown {
        options: Theme.names;
        selected: Theme.names[Theme.index];
        tip: "Colours of the highlights and text";
        picked(v) => { Options.set-theme(v); }
    }
    SettingRow {
        label: "Fullscreen";
        detail: "F11 toggles it too";
        Toggle {
            tip: "Fill the whole screen; the track bar then slides down from the top edge";
            checked: Options.fullscreen;
            toggled(v) => { Options.set-fullscreen(v); }
        }
    }
    if Options.brightness-available: SectionTitle { text: "BRIGHTNESS"; }
    SectionTitle { text: "PLUGIN EDITOR SIZE"; }
    Text {
        text: "Draws plugin editors larger, on top of the desktop's scale, for touchscreens. Editors that can be resized also shrink to fit the space they are given. Changing it restarts the audio engine.";
        color: Theme.text-dim;
        font-size: Theme.font-small;
        font-weight: Theme.regular;
        wrap: word-wrap;
    }
    Dropdown {
        options: Options.editor-zooms;
        selected: Options.editor-zoom;
        tip: "Scale for plugin editors that support it (LV2, VST3, CLAP)";
        picked(v) => { Options.set-editor-zoom(v); }
    }
    if Options.brightness-available: BigSlider {
        tip: "Screen brightness";
        minimum: 5;
        maximum: 100;
        value: Options.brightness;
        changed(v) => { Options.set-brightness(v); }
    }
}

export component OptionsPanel inherits Rectangle {
    in-out property <int> page: 0;
    callback close;
    callback page-opened(int);

    background: Theme.popup;
    border-width: 1px;
    border-color: Theme.border;

    property <[{solid: string, line: string, label: string}]> pages: [
        { solid: Icons.audio-solid, line: Icons.audio-line, label: "Audio" },
        { solid: Icons.presets-solid, line: Icons.presets-line, label: "Presets" },
        { solid: Icons.midi-solid, line: Icons.midi-line, label: "MIDI" },
        { solid: Icons.wifi-solid, line: Icons.wifi-line, label: "WiFi" },
        { solid: Icons.bluetooth-solid, line: Icons.bluetooth-line, label: "Bluetooth" },
        { solid: Icons.display-solid, line: Icons.display-line, label: "Display" },
    ];

    // Under everything: keeps taps on the panel's empty space from reaching
    // the scrim (which would close the panel). A swipe right still closes it.
    TouchArea {
        moved => {
            if self.mouse-x - self.pressed-x > 60px {
                root.close();
            }
        }
    }

    HorizontalLayout {
        // Section rail.
        Rectangle {
            width: 92px;
            background: #00000066;
            VerticalLayout {
                padding-top: 8px;
                spacing: 2px;
                alignment: start;
                for p[i] in root.pages: Rectangle {
                    height: 76px;
                    background: i == root.page ? Theme.pressed : transparent;
                    Rectangle {
                        x: 0;
                        width: 4px;
                        background: i == root.page ? Theme.paint : transparent;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 6px;
                        HorizontalLayout {
                            alignment: center;
                            Icon {
                                width: 26px;
                                height: 26px;
                                solid: p.solid;
                                line: p.line;
                                weight: 1.8;
                                tint: i == root.page ? #ffffff : #ffffffa6;
                            }
                        }
                        Text {
                            text: p.label;
                            font-size: 12px;
                            font-weight: Theme.regular;
                            horizontal-alignment: center;
                            color: i == root.page ? Theme.text : Theme.text-dim;
                        }
                    }
                    TouchArea {
                        clicked => {
                            root.page = i;
                            root.page-opened(i);
                        }
                    }
                }
            }
            // Swipe right on the rail closes the panel.
            TouchArea {
                y: parent.height - 120px;
                height: 120px;
                moved => {
                    if self.mouse-x - self.pressed-x > 60px {
                        root.close();
                    }
                }
            }
        }

        VerticalLayout {
            // The header stays at the top whatever the page: the page's
            // title, then the app and computer buttons, with Quit in the
            // top right corner, where windows have their close button.
            HorizontalLayout {
                padding-left: Theme.pad;
                padding-right: Theme.pad;
                padding-top: Theme.pad;
                padding-bottom: 6px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    CollapseButton {
                        icon: Icons.chevron-right;
                        tip: "Close options";
                        clicked => { root.close(); }
                    }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    Text {
                        text: root.pages[root.page].label;
                        font-size: Theme.font-title;
                        color: Theme.text;
                        overflow: elide;
                    }
                    Text {
                        text: "Carlita " + Options.version;
                        font-size: Theme.font-small;
                        font-weight: Theme.regular;
                        color: Theme.text-faint;
                        overflow: elide;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.reboot-line;
                            danger: true;
                            tip: "Reboot the computer (asks first)";
                            clicked => { Options.reboot(); }
                        }
                    }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.power-line;
                            danger: true;
                            tip: "Shut down the computer (asks first)";
                            clicked => { Options.shutdown(); }
                        }
                    }
                    // A gap, so Quit is not tapped by mistake for its neighbour.
                    Rectangle { width: 8px; }
                    VerticalLayout {
                        alignment: center;
                        IconButton {
                            icon: Icons.close;
                            danger: true;
                            tip: "Quit Carlita (asks first)";
                            clicked => { Options.quit(); }
                        }
                    }
                }
            }
            Rectangle {
                height: 1px;
                background: Theme.border;
            }

            Flickable {
                vertical-stretch: 1;
                content-height: content.preferred-height;
                content := VerticalLayout {
                    padding: Theme.pad * 1.5;
                    padding-top: Theme.pad;
                    spacing: 14px;
                    alignment: start;
                    if root.page == 0: AudioPage { }
                    if root.page == 1: PresetsPage { }
                    if root.page == 2: MidiPage { }
                    if root.page == 3: WifiPage { }
                    if root.page == 4: BluetoothPage { }
                    if root.page == 5: DisplayPage { }
                }
            }
        }
    }
}
