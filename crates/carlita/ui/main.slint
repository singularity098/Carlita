// Carlita main window.
//
// Layout: the track bar on top (docked in a window; in fullscreen it slides
// down from the top edge), the plugin editor filling the rest of the window
// up to its edges, a strip on each screen edge that brings in a sidebar (or
// the track bar, or the keyboard), and two sidebars that slide over the
// editor. A plugin editor is a window of its own placed over the main area,
// which nothing drawn here can cover. So the editor host puts invisible
// input-only windows over it along the edges (see `edge-top`), which pass
// touches and the mouse on to this window, so the strips work over the
// editor too. While the mouse hovers a strip, the editor is cut back by the
// width of the strip's tab (see `uncovered-x`) and a snapshot of it is drawn
// under the see-through tab. While a sidebar, the fullscreen track bar, the
// browser or a dialog is open, the editor is hidden and its snapshot shows
// under them, so a tap anywhere outside a sidebar closes it.
import "../../../assets/fonts/Jost-Light.ttf";
import "../../../assets/fonts/Jost-Regular.ttf";
import { Theme, ThemeLook } from "theme.slint";
import { BigButton, BigSlider, Toggle, SectionTitle } from "widgets.slint";
import { SlotItem, TrackItem, PluginItem, ParamItem, WifiItem, BtItem, MappingItem } from "types.slint";
import { ChainPanel } from "chain.slint";
import { PluginBrowser } from "browser.slint";
import { OptionsPanel, Options } from "options.slint";
import { TextPrompt, Piano, TextUtil } from "keyboards.slint";
import { TrackBar } from "trackbar.slint";
import { Icon, Icons } from "icons.slint";
import { Tips, TooltipLayer } from "tooltip.slint";

export { Theme, ThemeLook, Options, TextUtil, SlotItem, TrackItem, PluginItem, ParamItem, WifiItem, BtItem, MappingItem }

// A sidebar that follows the finger and snaps open or closed.
component EdgeStrip inherits Rectangle {
    in property <bool> right-side;
    in property <length> panel-width;
    in property <string> icon;
    in property <string> icon-solid;
    // Called continuously while dragging (0..1) and once on release.
    callback drag(float);
    callback release(float, bool);
    callback tap;
    // The mouse is over the strip (its tab shows).
    out property <bool> hovered: self.visible && (strip.has-hover || tab-touch.has-hover);
    out property <length> tab-width: tab.width;

    property <float> amount: 0;

    // Visible tab, only while the mouse hovers the edge (so editors can use
    // the full screen otherwise).
    tab := Rectangle {
        visible: strip.has-hover || tab-touch.has-hover;
        width: 44px;
        height: 120px;
        x: root.right-side ? root.width - self.width : 0;
        y: (root.height - self.height) / 2;
        border-radius: 10px;
        // See-through, so it does not hide what is under it.
        background: tab-touch.pressed ? Theme.paint : #00000073;
        border-width: 1px;
        border-color: tab-touch.pressed ? transparent : Theme.border-hover;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            line: root.icon;
            solid: root.icon-solid;
            tint: tab-touch.pressed ? Theme.on-paint : Theme.text;
        }
        tab-touch := TouchArea {
            clicked => { root.tap(); }
        }
    }

    strip := TouchArea {
        width: root.width;
        x: 0;
        moved => {
            root.amount = max(0, min(1, (root.right-side ? self.pressed-x - self.mouse-x : self.mouse-x - self.pressed-x) / root.panel-width));
            root.drag(root.amount);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                // A tap on the strip with the mouse also opens it.
                if abs(self.mouse-x - self.pressed-x) < 4px && e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.tap();
                } else {
                    root.release(root.amount, root.amount > 0.33);
                }
                root.amount = 0;
            }
        }
    }
}

// The strip along the top edge in fullscreen: swipe down (or tap the tab
// that shows while the mouse hovers it) to bring in the track bar.
component TopStrip inherits Rectangle {
    in property <length> bar-height;
    callback drag(float);
    callback release(bool);
    callback tap;
    out property <bool> hovered: self.visible && (strip.has-hover || tab-touch.has-hover);
    out property <length> tab-height: tab.height;

    property <float> amount: 0;

    tab := Rectangle {
        visible: strip.has-hover || tab-touch.has-hover;
        width: 120px;
        height: 36px;
        x: (root.width - self.width) / 2;
        y: 0;
        border-radius: 10px;
        background: tab-touch.pressed ? Theme.paint : #00000073;
        border-width: 1px;
        border-color: tab-touch.pressed ? transparent : Theme.border-hover;
        Text {
            text: "Tracks";
            font-size: Theme.font-small;
            font-weight: Theme.regular;
            color: tab-touch.pressed ? #000 : Theme.text;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        tab-touch := TouchArea {
            clicked => { root.tap(); }
        }
    }

    strip := TouchArea {
        height: root.height;
        y: 0;
        moved => {
            root.amount = max(0, min(1, (self.mouse-y - self.pressed-y) / root.bar-height));
            root.drag(root.amount);
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up || e.kind == PointerEventKind.cancel {
                if abs(self.mouse-y - self.pressed-y) < 4px && e.kind == PointerEventKind.up && e.button == PointerEventButton.left {
                    root.tap();
                } else {
                    root.release(root.amount > 0.33);
                }
                root.amount = 0;
            }
        }
    }
}

// The strip along the bottom edge while the on-screen keyboard is hidden:
// swipe up (or tap the tab that shows while the mouse hovers it) to bring
// the keyboard in.
component BottomStrip inherits Rectangle {
    callback open;
    out property <bool> hovered: self.visible && (strip.has-hover || tab-touch.has-hover);
    out property <length> tab-height: tab.height;

    tab := Rectangle {
        visible: strip.has-hover || tab-touch.has-hover;
        width: 120px;
        height: 36px;
        x: (root.width - self.width) / 2;
        y: root.height - self.height;
        border-radius: 10px;
        background: tab-touch.pressed ? Theme.paint : #00000073;
        border-width: 1px;
        border-color: tab-touch.pressed ? transparent : Theme.border-hover;
        Icon {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            line: Icons.keys-line;
            solid: Icons.keys-solid;
            weight: 1.6;
            tint: tab-touch.pressed ? Theme.on-paint : Theme.text;
        }
        tab-touch := TouchArea {
            clicked => { root.open(); }
        }
    }

    strip := TouchArea {
        moved => {
            if self.pressed-y - self.mouse-y > 24px {
                root.open();
            }
        }
        pointer-event(e) => {
            if e.kind == PointerEventKind.up && e.button == PointerEventButton.left
                && abs(self.mouse-y - self.pressed-y) < 4px {
                root.open();
            }
        }
    }
}

// An invisible handle on the window border that resizes the window.
component ResizeHandle inherits TouchArea {
    in property <string> direction;
    callback start(string);
    mouse-cursor: root.direction == "n" || root.direction == "s" ? ns-resize
        : root.direction == "e" || root.direction == "w" ? ew-resize
        : root.direction == "nw" || root.direction == "se" ? nwse-resize
        : nesw-resize;
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.start(root.direction);
        }
    }
}

export component MainWindow inherits Window {
    title: "Carlita";
    // Carlita draws its own title bar (the track bar).
    no-frame: true;
    icon: @image-url("../../../assets/branding/png/carlita-app-icon-256.png");
    background: Theme.bg;
    min-width: 800px;
    min-height: 480px;
    preferred-width: 1280px;
    preferred-height: 800px;
    default-font-size: Theme.font;
    default-font-family: "Jost";
    default-font-weight: Theme.light;

    // ---------------------------------------------------------- properties
    in property <length> strip-width: 18px;

    // Sidebars: 0 = closed, 1 = open.
    in-out property <float> left-pos: 0;
    in-out property <float> right-pos: 0;
    property <bool> left-dragging;
    property <bool> right-dragging;
    property <length> left-width: min(460px, root.width * 0.9);

    // Track bar: docked in a window; in fullscreen 0 = hidden, 1 = shown.
    in property <bool> window-maximized;
    in-out property <float> top-pos: 0;
    property <bool> top-dragging;
    property <length> bar-height: 52px;
    // How far the fullscreen track bar reaches down, following the slide.
    property <length> top-shown: root.top-pos * root.bar-height;
    animate top-shown { duration: root.top-dragging ? 0ms : Theme.slide; easing: ease-out; }
    property <bool> docked: !Options.fullscreen;
    property <length> top-inset: root.docked ? root.bar-height : 0;
    property <length> right-width: min(720px, root.width * 0.92);

    // Chain.
    in property <[SlotItem]> slots;
    in property <float> in-left;
    in property <float> in-right;
    in property <float> out-left;
    in property <float> out-right;
    in property <string> dsp-load: "–";
    in property <string> latency: "–";
    in property <string> preset-name;
    in property <string> undo-text;
    in property <length> drop-y: -1px;

    // Tracks.
    in property <[TrackItem]> tracks;
    in property <string> track-name;
    in property <string> track-input;
    in property <bool> track-muted;
    in property <float> track-volume: 1;
    in property <string> track-volume-text;
    in property <float> track-left;
    in property <float> track-right;

    // Main area.
    in property <string> editor-mode: "empty"; // empty | embedded | params | waiting | message
    in property <string> editor-title;
    in property <string> editor-message;
    // Where a plugin's own editor window is placed. It sits above everything
    // drawn here, so it is cut down to the part of the area that the
    // sidebars, the fullscreen track bar and the toast leave uncovered
    // (following them as they slide), and hidden under the browser and
    // dialogs.
    out property <length> area-x: editor-area.x;
    out property <length> area-y: editor-area.y;
    out property <length> area-width: editor-area.width;
    out property <length> area-height: editor-area.height;
    property <bool> editor-hidden: root.browser-open || root.prompt-open || root.confirm-text != ""
        || root.left-pos > 0 || root.right-pos > 0 || (!root.docked && root.top-pos > 0);
    // While the mouse hovers an edge strip, its tab shows over the editor's
    // snapshot.
    property <length> uncovered-left: max(editor-area.x,
        left-strip.hovered ? left-strip.tab-width : 0);
    property <length> uncovered-right: min(editor-area.x + editor-area.width,
        right-strip.hovered ? root.width - right-strip.tab-width : root.width);
    property <length> uncovered-top: max(editor-area.y,
        top-strip.hovered ? top-strip.tab-height : 0);
    property <length> uncovered-bottom: min(editor-area.y + editor-area.height,
        root.toast != "" ? toast-box.y : root.height,
        bottom-strip.hovered ? root.height - bottom-strip.tab-height : root.height);
    out property <length> uncovered-x: root.uncovered-left;
    out property <length> uncovered-y: root.uncovered-top;
    out property <length> uncovered-width: root.editor-hidden ? 0 : max(0, root.uncovered-right - root.uncovered-left);
    out property <length> uncovered-height: root.editor-hidden ? 0 : max(0, root.uncovered-bottom - root.uncovered-top);
    // Where the edge strips are, for the input-only windows the editor host
    // puts over the editor: the side strips run from `edge-top` to
    // `edge-bottom`, the top strip is there in fullscreen (`edge-top-strip`)
    // and the bottom strip while the keyboard is hidden.
    out property <length> edge-top: root.top-inset;
    out property <length> edge-bottom: root.height - root.keyboard-height;
    out property <bool> edge-top-strip: !root.docked;
    out property <bool> edge-bottom-strip: !root.keyboard-visible;
    // A picture of the editor taken just before something started to cover
    // it, drawn where the editor is (window coordinates).
    in property <image> editor-snapshot;
    in property <length> snapshot-x;
    in property <length> snapshot-y;
    in property <length> snapshot-width;
    in property <length> snapshot-height;
    in property <[ParamItem]> params;

    // Browser.
    in-out property <bool> browser-open;
    in property <[PluginItem]> browser-plugins;
    in property <[string]> browser-formats;
    in property <[string]> browser-categories;
    in-out property <string> browser-search;
    in property <string> browser-format;
    in property <string> browser-category;
    in property <bool> browser-favorites;
    in property <string> scan-status;
    in property <bool> scanning;

    // Prompt / confirm / toast.
    in-out property <bool> prompt-open;
    in-out property <string> prompt-title;
    in-out property <string> prompt-text;
    in-out property <bool> prompt-secret;
    in-out property <string> confirm-text;
    in-out property <string> toast;
    in property <bool> toast-error;

    // Keyboard.
    in property <bool> keyboard-visible;
    in property <int> keyboard-base: 48;
    property <length> keyboard-height: root.keyboard-visible ? min(220px, root.height * 0.3) : 0;
    // What the bottom edge takes: the keyboard, or the strip that brings it in.
    property <length> bottom-inset: root.keyboard-visible ? root.keyboard-height : root.strip-width;

    // ----------------------------------------------------------- callbacks
    callback select-slot(int);
    callback toggle-bypass(int, bool);
    callback remove-slot(int);
    callback drag-hover(int, length);
    callback drag-drop(int);
    callback split-slot(int);
    callback add-lane(int);
    callback remove-lane(int);
    callback add-to-lane(int);
    callback select-track(int);
    callback close-track(int);
    callback start-drag;
    callback start-resize(string);
    callback minimize-window;
    callback toggle-maximize;
    callback close-window;
    callback add-track;
    callback rename-track;
    callback rename-track-to(int, string);
    callback delete-track;
    callback cycle-input;
    callback toggle-mute;
    callback set-volume(float);
    callback undo-remove;
    callback open-browser;
    callback browser-filter(string, string, string, bool);
    callback browser-pick(string);
    callback browser-favorite(string);
    callback rescan;
    callback browser-keyboard;
    callback area-changed;
    callback set-param(int, float);
    callback prompt-done(bool, string);
    callback confirm-done(bool);
    callback piano-note(int, bool);
    callback piano-octave(int);
    callback toggle-fullscreen;
    callback options-page(int);
    changed uncovered-x => { root.area-changed(); }
    changed uncovered-y => { root.area-changed(); }
    changed uncovered-width => { root.area-changed(); }
    changed uncovered-height => { root.area-changed(); }

    function open-left() { root.left-pos = 1; root.right-pos = 0; root.top-pos = 0; }
    function open-top() { root.top-pos = 1; root.left-pos = 0; root.right-pos = 0; }
    function close-top() { root.top-pos = 0; }
    function close-left() { root.left-pos = 0; }
    function open-right() { root.right-pos = 1; root.left-pos = 0; root.top-pos = 0; }
    function close-right() { root.right-pos = 0; }

    // Typing goes back to the window's own key handling when the text
    // prompt (whose field has the focus while open) or the browser (whose
    // search box had it) closes.
    changed prompt-open => {
        Tips.hide();
        if !root.prompt-open && !root.browser-open { keys.focus(); }
    }
    changed browser-open => {
        Tips.hide();
        if !root.browser-open { keys.focus(); }
    }
    changed confirm-text => {
        Tips.hide();
        if root.confirm-text != "" { keys.focus(); }
    }
    // A tip whose control slides away or goes with a panel goes too.
    changed left-pos => { Tips.hide(); }
    changed right-pos => { Tips.hide(); }
    changed top-pos => { Tips.hide(); }

    forward-focus: keys;
    keys := FocusScope {
        key-pressed(e) => {
            // The text prompt's field types itself; should it have lost the
            // focus, Return and Escape still answer the prompt.
            if root.prompt-open {
                if e.text == Key.Return {
                    root.prompt-open = false;
                    root.prompt-done(true, root.prompt-text);
                    return accept;
                }
                if e.text == Key.Escape {
                    root.prompt-open = false;
                    root.prompt-done(false, "");
                    return accept;
                }
                return accept;
            }
            if root.confirm-text != "" {
                if e.text == Key.Return {
                    root.confirm-text = "";
                    root.confirm-done(true);
                    return accept;
                }
                if e.text == Key.Escape {
                    root.confirm-text = "";
                    root.confirm-done(false);
                    return accept;
                }
            }
            if e.text == Key.F11 {
                root.toggle-fullscreen();
                return accept;
            }
            if e.text == Key.Escape {
                if root.browser-open { root.browser-open = false; return accept; }
                if root.top-pos > 0 { root.close-top(); return accept; }
                if root.left-pos > 0 { root.close-left(); return accept; }
                if root.right-pos > 0 { root.close-right(); return accept; }
            }
            reject
        }
    }

    // ------------------------------------------------------------ main area
    // The whole window below the docked track bar and above the keyboard.
    editor-area := Rectangle {
        x: 0;
        y: root.top-inset;
        width: root.width;
        height: root.height - self.y - root.keyboard-height;
        clip: true;
        changed x => { root.area-changed(); }
        changed y => { root.area-changed(); }
        changed width => { root.area-changed(); }
        changed height => { root.area-changed(); }

        // The editor window covers this. Where something covers the editor,
        // its snapshot shows through, or its name if there is none yet.
        if root.editor-mode == "embedded" && root.snapshot-width > 0: Image {
            x: root.snapshot-x - editor-area.x;
            y: root.snapshot-y - editor-area.y;
            width: root.snapshot-width;
            height: root.snapshot-height;
            source: root.editor-snapshot;
            image-fit: fill;
            accessible-role: none;
        }
        if root.editor-mode == "embedded" && root.snapshot-width == 0: Text {
            text: root.editor-title;
            font-size: Theme.font-title;
            color: Theme.text-faint;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        if root.editor-mode == "params": Flickable {
            content-height: params-col.preferred-height;
            params-col := VerticalLayout {
                padding: 24px;
                spacing: 10px;
                alignment: start;
                Text {
                    text: root.editor-title;
                    font-size: Theme.font-title;
                    color: Theme.text;
                }
                Text {
                    text: root.params.length == 0 ? "This plugin has no adjustable parameters." : "This plugin has no editor of its own.";
                    color: Theme.text-dim;
                }
                for p in root.params: Rectangle {
                    height: 84px;
                    border-radius: Theme.radius;
                    background: Theme.surface;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    HorizontalLayout {
                        padding-left: Theme.pad;
                        padding-right: Theme.pad;
                        spacing: Theme.pad;
                        VerticalLayout {
                            width: 220px;
                            alignment: center;
                            Text {
                                text: p.name;
                                font-size: Theme.font;
                                color: Theme.text;
                                overflow: elide;
                            }
                            Text {
                                text: p.text;
                                font-size: Theme.font-small;
                                font-weight: Theme.regular;
                                color: Theme.accent;
                            }
                        }
                        if p.is-bool: Toggle {
                            tip: p.name + ": on or off";
                            checked: p.value > (p.minimum + p.maximum) / 2;
                            toggled(v) => { root.set-param(p.index, v ? p.maximum : p.minimum); }
                        }
                        if !p.is-bool: BigSlider {
                            tip: p.name + ": drag to set it.";
                            y: (parent.height - self.height) / 2;
                            minimum: p.minimum;
                            maximum: p.maximum;
                            value: p.value;
                            has-default: true;
                            default-value: p.default;
                            changed(v) => { root.set-param(p.index, p.is-int ? round(v) : v); }
                        }
                    }
                }
            }
        }

        if root.editor-mode == "empty" || root.editor-mode == "waiting" || root.editor-mode == "message": VerticalLayout {
            alignment: center;
            spacing: 18px;
            if root.editor-mode == "empty": Image {
                source: @image-url("../../../assets/branding/carlita-logo.svg");
                height: 96px;
                image-fit: contain;
                accessible-role: image;
                accessible-label: "Carlita";
            }
            if root.editor-mode != "empty": Text {
                text: root.editor-mode == "waiting" ? "Opening " + root.editor-title + "…" : root.editor-title;
                font-size: 34px;
                color: Theme.text;
                horizontal-alignment: center;
            }
            Text {
                text: root.editor-mode == "empty" ? "Swipe in from the left edge for the chain,\nfrom the right edge for options." : root.editor-message;
                font-size: Theme.font-large;
                color: Theme.text-dim;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
            if root.editor-mode == "empty": HorizontalLayout {
                alignment: center;
                spacing: 12px;
                BigButton {
                    text: "Open chain";
                    tip: "The plugins of this track (or swipe in from the left edge)";
                    primary: true;
                    clicked => { root.open-left(); }
                }
                BigButton {
                    text: "Options";
                    tip: "Audio, presets, MIDI, WiFi, Bluetooth and display (or swipe in from the right edge)";
                    clicked => { root.open-right(); }
                }
            }
        }
    }

    // On-screen piano.
    if root.keyboard-visible: Piano {
        x: root.strip-width;
        width: root.width - 2 * root.strip-width;
        y: root.height - root.keyboard-height;
        height: root.keyboard-height;
        base-note: root.keyboard-base;
        octaves: root.width > 1100px ? 4 : root.width > 800px ? 3 : 2;
        note(n, on) => { root.piano-note(n, on); }
        octave(d) => { root.piano-octave(d); }
        close => { Options.set-keyboard(false); }
    }
    bottom-strip := BottomStrip {
        visible: !root.keyboard-visible;
        x: root.strip-width;
        width: root.width - 2 * root.strip-width;
        y: root.height - root.strip-width;
        height: root.strip-width;
        open => { Options.set-keyboard(true); }
    }

    // Docked track bar (windowed).
    if root.docked: TrackBar {
        x: 0;
        y: 0;
        width: root.width;
        height: root.bar-height;
        tracks: root.tracks;
        fullscreen: false;
        maximized: root.window-maximized;
        pick-track(id) => { root.select-track(id); }
        tab-clicked(id, was-selected) => {
            if was-selected { root.open-left(); }
        }
        close-track(id) => { root.close-track(id); }
        rename-started(id) => { root.close-left(); }
        rename-track(id, name) => { root.rename-track-to(id, name); }
        rename-ended => { keys.focus(); }
        add-track => {
            root.add-track();
            root.open-left();
        }
        start-drag => { root.start-drag(); }
        toggle-maximize => { root.toggle-maximize(); }
        minimize => { root.minimize-window(); }
        close-window => { root.close-window(); }
        toggle-fullscreen => { root.toggle-fullscreen(); }
    }

    // ------------------------------------------------------------ sidebars
    // Scrim: tap outside, or swipe, to close.
    if root.left-pos > 0 || root.right-pos > 0: Rectangle {
        y: root.top-inset;
        height: root.height - root.top-inset;
        // A see-through colour, not `opacity`: with `opacity` (on an element
        // with children) the whole window-sized scrim was drawn into an
        // offscreen layer on every frame, which cost a high-refresh display
        // its frame rate while a sidebar was out.
        background: Colors.rgba(0, 0, 0, 0.6 * max(root.left-pos, root.right-pos));
        TouchArea {
            property <bool> swiped;
            moved => {
                if root.left-pos > 0 && self.mouse-x - self.pressed-x < -40px { self.swiped = true; }
                if root.right-pos > 0 && self.mouse-x - self.pressed-x > 40px { self.swiped = true; }
            }
            pointer-event(e) => {
                if e.kind == PointerEventKind.up {
                    root.close-left();
                    root.close-right();
                    self.swiped = false;
                }
            }
        }
    }

    chain-panel := ChainPanel {
        y: root.top-inset;
        width: root.left-width;
        height: root.height - root.top-inset;
        x: (root.left-pos - 1) * root.left-width;
        visible: root.left-pos > 0;
        animate x { duration: root.left-dragging ? 0ms : Theme.slide; easing: ease-out; }
        slots: root.slots;
        in-left: root.in-left;
        in-right: root.in-right;
        out-left: root.out-left;
        out-right: root.out-right;
        dsp-load: root.dsp-load;
        latency: root.latency;
        preset-name: root.preset-name;
        undo-text: root.undo-text;
        drop-y: root.drop-y;
        track-name: root.track-name;
        track-input: root.track-input;
        track-muted: root.track-muted;
        track-volume: root.track-volume;
        track-volume-text: root.track-volume-text;
        track-left: root.track-left;
        track-right: root.track-right;
        select(id) => {
            root.select-slot(id);
            root.close-left();
        }
        toggle-bypass(id, b) => { root.toggle-bypass(id, b); }
        remove(id) => { root.remove-slot(id); }
        drag-hover(row, y) => { root.drag-hover(row, y); }
        drag-drop(row) => { root.drag-drop(row); }
        split(id) => { root.split-slot(id); }
        add-lane(row) => { root.add-lane(row); }
        remove-lane(row) => { root.remove-lane(row); }
        add-to-lane(row) => { root.add-to-lane(row); }
        rename-track => { root.rename-track(); }
        delete-track => { root.delete-track(); }
        cycle-input => { root.cycle-input(); }
        toggle-mute => { root.toggle-mute(); }
        set-volume(v) => { root.set-volume(v); }
        add-plugin => { root.open-browser(); }
        undo => { root.undo-remove(); }
        close => { root.close-left(); }
    }

    options-panel := OptionsPanel {
        y: root.top-inset;
        width: root.right-width;
        height: root.height - root.top-inset;
        x: root.width - root.right-pos * root.right-width;
        visible: root.right-pos > 0;
        animate x { duration: root.right-dragging ? 0ms : Theme.slide; easing: ease-out; }
        close => { root.close-right(); }
        page-opened(i) => { root.options-page(i); }
    }

    // Fullscreen: the track bar slides down over everything, with a scrim
    // below it that closes it on a tap.
    if !root.docked && root.top-pos > 0: Rectangle {
        background: Colors.rgba(0, 0, 0, 0.45 * root.top-pos);
        TouchArea {
            clicked => { root.close-top(); }
        }
    }
    if !root.docked: TrackBar {
        x: 0;
        y: root.top-shown - root.bar-height;
        width: root.width;
        height: root.bar-height;
        visible: root.top-pos > 0;
        tracks: root.tracks;
        fullscreen: true;
        maximized: root.window-maximized;
        pick-track(id) => { root.select-track(id); }
        tab-clicked(id, was-selected) => {
            root.close-top();
            if was-selected { root.open-left(); }
        }
        close-track(id) => {
            root.close-top();
            root.close-track(id);
        }
        rename-track(id, name) => { root.rename-track-to(id, name); }
        rename-ended => { keys.focus(); }
        minimize => { root.minimize-window(); }
        toggle-maximize => {
            root.close-top();
            root.toggle-maximize();
        }
        close-window => { root.close-window(); }
        add-track => {
            root.add-track();
            root.open-left();
        }
        toggle-fullscreen => {
            root.close-top();
            root.toggle-fullscreen();
        }
        dismiss => { root.close-top(); }
    }

    // -------------------------------------------------------- edge strips
    // Above the sidebars' scrims, so one sidebar can be pulled out while the
    // other (or the fullscreen track bar) is open: that one then closes. A
    // strip is gone while its own panel is open.
    left-strip := EdgeStrip {
        visible: root.left-pos == 0 || root.left-dragging;
        x: 0;
        y: max(root.top-inset, !root.docked ? root.top-shown : 0);
        width: root.strip-width;
        height: root.height - self.y;
        icon: Icons.menu-line;
        panel-width: root.left-width;
        drag(a) => {
            root.left-dragging = true;
            root.right-pos = 0;
            root.top-pos = 0;
            root.left-pos = a;
        }
        release(a, open) => {
            root.left-dragging = false;
            if open { root.open-left(); } else { root.close-left(); }
        }
        tap => { root.open-left(); }
    }
    right-strip := EdgeStrip {
        visible: root.right-pos == 0 || root.right-dragging;
        x: root.width - root.strip-width;
        y: max(root.top-inset, !root.docked ? root.top-shown : 0);
        width: root.strip-width;
        height: root.height - self.y;
        right-side: true;
        icon: Icons.system-line;
        panel-width: root.right-width;
        drag(a) => {
            root.right-dragging = true;
            root.left-pos = 0;
            root.top-pos = 0;
            root.right-pos = a;
        }
        release(a, open) => {
            root.right-dragging = false;
            if open { root.open-right(); } else { root.close-right(); }
        }
        tap => { root.open-right(); }
    }

    // Clear of an open sidebar, so it does not cover the sidebar's top.
    top-strip := TopStrip {
        visible: !root.docked && (root.top-pos == 0 || root.top-dragging);
        x: root.left-pos > 0 ? root.left-width : root.strip-width;
        y: 0;
        width: (root.right-pos > 0 ? root.width - root.right-width : root.width - root.strip-width) - self.x;
        height: root.strip-width;
        bar-height: root.bar-height;
        drag(a) => {
            root.top-dragging = true;
            root.left-pos = 0;
            root.right-pos = 0;
            root.top-pos = a;
        }
        release(open) => {
            root.top-dragging = false;
            if open { root.open-top(); } else { root.close-top(); }
        }
        tap => { root.open-top(); }
    }

    // ------------------------------------------------------------- overlays
    if root.browser-open: PluginBrowser {
        plugins: root.browser-plugins;
        formats: root.browser-formats;
        categories: root.browser-categories;
        search <=> root.browser-search;
        format-filter: root.browser-format;
        category-filter: root.browser-category;
        favorites-only: root.browser-favorites;
        scan-status: root.scan-status;
        scanning: root.scanning;
        filter-changed(t, f, c, fav) => { root.browser-filter(t, f, c, fav); }
        pick(k) => { root.browser-pick(k); }
        toggle-favorite(k) => { root.browser-favorite(k); }
        rescan => { root.rescan(); }
        prompt-open: root.prompt-open;
        close => { root.browser-open = false; }
        request-keyboard => { root.browser-keyboard(); }
    }

    if root.prompt-open: TextPrompt {
        title: root.prompt-title;
        secret: root.prompt-secret;
        text <=> root.prompt-text;
        accepted(t) => {
            root.prompt-open = false;
            root.prompt-done(true, t);
        }
        cancelled => {
            root.prompt-open = false;
            root.prompt-done(false, "");
        }
    }

    if root.confirm-text != "": Rectangle {
        background: Theme.scrim;
        TouchArea { }
        Rectangle {
            width: min(520px, root.width - 40px);
            height: 200px;
            x: (root.width - self.width) / 2;
            y: (root.height - self.height) / 2;
            border-radius: Theme.radius * 1.5;
            background: Theme.popup;
            border-width: 1px;
            border-color: Theme.border;
            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                Text {
                    text: root.confirm-text;
                    font-size: Theme.font-large;
                    color: Theme.text;
                    wrap: word-wrap;
                    vertical-stretch: 1;
                }
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    BigButton {
                        text: "Cancel";
                        clicked => {
                            root.confirm-text = "";
                            root.confirm-done(false);
                        }
                    }
                    BigButton {
                        text: "Yes";
                        danger: true;
                        clicked => {
                            root.confirm-text = "";
                            root.confirm-done(true);
                        }
                    }
                }
            }
        }
    }

    // Always there (only shown with a message) so the editor can make room
    // above it.
    toast-box := Rectangle {
        visible: root.toast != "";
        width: min(toast-text.preferred-width + 40px, root.width - 80px);
        height: max(52px, toast-text.preferred-height + 24px);
        x: (root.width - self.width) / 2;
        y: root.height - root.keyboard-height - self.height - 24px;
        border-radius: Theme.radius;
        background: root.toast-error ? Theme.danger.mix(#000, 25%).transparentize(5%) : Theme.popup;
        border-width: 1px;
        border-color: root.toast-error ? Theme.danger : Theme.border-strong;
        toast-text := Text {
            width: parent.width - 40px;
            text: root.toast;
            color: Theme.text;
            font-size: Theme.font;
            wrap: word-wrap;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { root.toast = ""; }
        }
    }

    // Window border handles (windowed and not maximized).
    if root.docked && !root.window-maximized: Rectangle {
        property <length> b: 5px;
        property <length> c: 14px;
        ResizeHandle { direction: "n"; x: parent.c; y: 0; width: root.width - 2 * parent.c; height: parent.b; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "s"; x: parent.c; y: root.height - parent.b; width: root.width - 2 * parent.c; height: parent.b; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "w"; x: 0; y: parent.c; width: parent.b; height: root.height - 2 * parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "e"; x: root.width - parent.b; y: parent.c; width: parent.b; height: root.height - 2 * parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "nw"; x: 0; y: 0; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "ne"; x: root.width - parent.c; y: 0; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "sw"; x: 0; y: root.height - parent.c; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
        ResizeHandle { direction: "se"; x: root.width - parent.c; y: root.height - parent.c; width: parent.c; height: parent.c; start(d) => { root.start-resize(d); } }
    }

    // Hover help, over everything else (it takes no input).
    TooltipLayer {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
    }

    // Phosphor's faint CRT lines, over everything (they take no input).
    if Theme.scanlines: Image {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        source: @image-url("../../../assets/background/scanlines.png");
        horizontal-tiling: repeat;
        vertical-tiling: repeat;
        accessible-role: none;
    }
}
