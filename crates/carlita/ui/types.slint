// Data exchanged between Rust and the UI.

// One row of the chain list: a plugin, or the header of a parallel block,
// the header of one of its lanes, or the "dry" placeholder of an empty lane.
export struct SlotItem {
    // Slot id for plugin rows, -1 otherwise.
    id: int,
    // "plugin", "parallel", "lane" or "dry"
    kind: string,
    // 1 inside a parallel lane.
    depth: int,
    // Header text for non-plugin rows.
    label: string,
    y: length,
    h: length,
    // Serial plugins can be split into a parallel block.
    can-split: bool,
    name: string,
    format: string,
    bypassed: bool,
    // Plugin delay compensation in samples, as text ("0 smp").
    latency: string,
    // "", "loading", "failed", "crashed"
    status: string,
    status-detail: string,
    selected: bool,
    midi-learned: bool,
}

export struct PluginItem {
    key: string,
    name: string,
    maker: string,
    format: string,
    category: string,
    favorite: bool,
    bridged: bool,
    synth: bool,
}

export struct ParamItem {
    index: int,
    name: string,
    value: float,
    minimum: float,
    maximum: float,
    // The plugin's default value (a double tap on the slider restores it).
    default: float,
    text: string,
    is-bool: bool,
    is-int: bool,
}

export struct WifiItem {
    ssid: string,
    strength: int,
    secured: bool,
    active: bool,
    known: bool,
}

export struct BtItem {
    path: string,
    name: string,
    paired: bool,
    connected: bool,
    icon: string,
}

export struct MappingItem {
    index: int,
    trigger: string,
    plugin: string,
    action: string,
}

export struct TrackItem {
    id: int,
    name: string,
    selected: bool,
    muted: bool,
    // Peak level of the track's output, 0..1.
    level: float,
}
